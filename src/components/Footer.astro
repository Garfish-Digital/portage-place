---
import Container from './primitives/Container.astro';
import Logo from './Logo.astro';
import { NAV_ITEMS, CONTACT } from '../config/nav';

const year = new Date().getFullYear();
---

<footer class="footer pp-on-dark">
	<Container>
		<div class="footer__meta">
			{/*
				The full lockup lives here and only here. It's the one place a visitor
				arrives having read the page, and it's where the scroll-triggered draw
				will go (BUILD_PLAN). `keepIds` is on for exactly one instance per page
				so the animation has targets without colliding with the header icon.

				The lockup's wordmark is outlined vector, so the visible name it shows
				is invisible to assistive tech — hence the visually-hidden text.
			*/}
			<div class="footer__brand" data-footer-brand>
				<Logo variant="lockup" class="footer__mark" keepIds />
				<span class="pp-visually-hidden">Portage Place</span>
			</div>

			<nav class="footer__nav" aria-label="Footer">
				<ul class="footer__list" role="list">
					{
						NAV_ITEMS.map((item) => (
							<li>
								<a class="footer__link" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<address class="footer__address">
				{CONTACT.address.street}<br />
				{CONTACT.address.city}, {CONTACT.address.region} {CONTACT.address.postalCode}
			</address>
		</div>

		<p class="footer__legal">
			&copy; {year} Portage Place. A restored 1919 bakery in South Bend, Indiana.
		</p>
	</Container>
</footer>


<script>
	// The footer logo draws itself once — and only once per visit.
	//
	// Order matters here. `.can-draw` is what hides the strokes, so it must not go
	// on until we have decided we are actually going to animate: if reduced motion
	// is set, or the mark has already drawn this session, we never touch the
	// element and the finished logo is what renders. That keeps "invisible" from
	// ever being a state we can get stuck in.
	//
	// sessionStorage rather than a per-page flag because navigation here is
	// cross-document (native view transitions), so every page is a fresh document
	// and the mark would otherwise redraw on Home, then History, then Community —
	// which starts to read as a splash screen rather than a signature.
	const brand = document.querySelector<HTMLElement>('[data-footer-brand]');
	const KEY = 'pp-footer-logo-drawn';

	const alreadyDrawn = () => {
		try {
			return sessionStorage.getItem(KEY) === '1';
		} catch {
			// Private mode and some embedded webviews throw on access. Treat that as
			// "already drawn" so the logo is simply present.
			return true;
		}
	};

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (brand && !reducedMotion && !alreadyDrawn() && 'IntersectionObserver' in window) {
		brand.classList.add('can-draw');

		const observer = new IntersectionObserver(
			([entry]) => {
				if (!entry.isIntersecting) return;
				brand.classList.add('is-drawing');
				try {
					sessionStorage.setItem(KEY, '1');
				} catch {
					/* nothing to do — the animation still runs this once */
				}
				observer.disconnect();
			},
			// A little of the plaque has to be on screen before it starts, or the
			// sequence plays out below the fold and the visitor never sees it.
			{ threshold: 0.4 },
		);

		observer.observe(brand);
	}
</script>

<style lang="scss">
	.footer {
		// Was `--pp-space-section` on top to clear a CTA block, which has moved out
		// to the pages — where it can offer a secondary action the footer never
		// could. Near-symmetric now; the footer anchors, it doesn't sell.
		padding-block: var(--pp-space-2xl) var(--pp-space-l);
		// Colour comes from .pp-on-dark, which remaps the semantic aliases for
		// everything inside — the logo included, which is why it renders plaster on
		// espresso with no variant of its own.
	}

	.footer__meta {
		display: grid;
		gap: var(--pp-space-l);

		@include from('md') {
			grid-template-columns: auto 1fr auto;
			align-items: start;
			gap: var(--pp-space-xl);
		}
	}

	// The client's mark is designed to sit on black, so it keeps its own plaque —
	// same construction as the header's, hairline and all.
	//
	// No padding: the lockup's viewBox already carries ~11% margin (the artwork
	// spans x 63–492 of 555), so the plaque breathes without any added inset.
	// `fit-content` because the brand is a block in a single-column grid on mobile
	// and would otherwise stretch the plaque far past the mark.
	.footer__brand {
		display: block;
		width: fit-content;
		background-color: var(--pp-ink-strong);
		border: 1px solid var(--pp-plaster);
	}

	// Inherits --pp-text from .pp-on-dark, so the mark renders plaster on espresso
	// with no variant of its own — the whole point of currentColor.
	:global(.footer__mark) {
		width: clamp(10.5rem, 18vw, 13rem);
		color: var(--pp-text-strong);
	}


	// ---------------------------------------------------------------------------
	// The logo draw
	// ---------------------------------------------------------------------------
	// Measured path lengths from the lockup: both icon strokes are 405.2 user
	// units and both rules are 91. Equal lengths mean equal durations look right
	// with no per-path compensation — a happy accident of a symmetric mark.
	//
	// THE DEFAULT IS THE FINISHED LOGO. Nothing below applies until JavaScript
	// adds `.can-draw`, because a stroke-dashoffset start state baked into the
	// stylesheet would leave the mark simply absent if the script never ran. That
	// is the same failure mode as the bio disclosure: a hidden default with no
	// guaranteed path back to visible.
	//
	// `:global()` because the lockup is injected with set:html, so Astro's scoping
	// cannot reach inside it. `.footer__brand` is written in this template, so it
	// still carries this component's scope — the rules stay confined to the footer.
	.footer__brand.can-draw {
		opacity: 0;

		:global(#icon-right),
		:global(#icon-left) {
			stroke-dasharray: 406;
			stroke-dashoffset: 406;
		}

		// Both rules run inner → outer. rule-right's path already starts at its
		// inner end, so a positive offset draws outward. rule-left's path starts at
		// its OUTER end, so it needs a negative offset to draw from the far end
		// backwards — otherwise it grows inward, mirroring the wrong way.
		:global(#rule-right) {
			stroke-dasharray: 91;
			stroke-dashoffset: 91;
		}

		:global(#rule-left) {
			stroke-dasharray: 91;
			stroke-dashoffset: -91;
		}

		// The letters are filled outlines, so they cannot be stroke-drawn. A wipe
		// reveals them instead — PORTAGE left to right, PLACE back the other way.
		:global(#wordmark-portage) {
			clip-path: inset(0 100% 0 0);
		}

		:global(#wordmark-place) {
			clip-path: inset(0 0 0 100%);
		}
	}

	.footer__brand.is-drawing {
		animation: plaque-in 400ms var(--pp-ease-out) forwards;

		:global(#icon-right) {
			animation: draw-line 620ms var(--pp-ease-out) 300ms forwards;
		}

		// Overlapped rather than sequential, so the interlock resolves as one
		// gesture instead of two separate strokes.
		:global(#icon-left) {
			animation: draw-line 620ms var(--pp-ease-out) 480ms forwards;
		}

		:global(#wordmark-portage) {
			animation: wipe-ltr 420ms var(--pp-ease-out) 1040ms forwards;
		}

		:global(#rule-right),
		:global(#rule-left) {
			animation: draw-line 340ms var(--pp-ease-out) 1380ms forwards;
		}

		:global(#wordmark-place) {
			animation: wipe-rtl 420ms var(--pp-ease-out) 1620ms forwards;
		}
	}

	@keyframes plaque-in {
		to {
			opacity: 1;
		}
	}

	@keyframes draw-line {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes wipe-ltr {
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes wipe-rtl {
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	.footer__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-xs) var(--pp-space-m);
		margin: 0;
		padding: 0;
	}

	.footer__link {
		font-size: var(--pp-text-s);
		color: var(--pp-text-muted);
		text-decoration: none;
		transition: color var(--pp-duration-fast) var(--pp-ease-out);

		@include focusable;

		@include hover-capable {
			&:hover {
				color: var(--pp-text-strong);
			}
		}
	}

	.footer__address {
		font-size: var(--pp-text-s);
		font-style: normal;
		line-height: var(--pp-leading-normal);
		color: var(--pp-text-muted);
	}

	.footer__legal {
		margin-block-start: var(--pp-space-xl);
		font-size: var(--pp-text-xs);
		color: var(--pp-text-muted);
	}
</style>
