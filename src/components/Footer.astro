---
import Container from './primitives/Container.astro';
import Logo from './Logo.astro';
import { NAV_ITEMS, CONTACT } from '../config/nav';

const year = new Date().getFullYear();
---

<footer class="footer pp-on-dark">
	<Container>
		<div class="footer__meta">
			{/*
				The full lockup lives here and only here. It's the one place a visitor
				arrives having read the page, and it's where the scroll-triggered draw
				will go (BUILD_PLAN). `keepIds` is on for exactly one instance per page
				so the animation has targets without colliding with the header icon.

				The lockup's wordmark is outlined vector, so the visible name it shows
				is invisible to assistive tech — hence the visually-hidden text.
			*/}
			<div class="footer__brand">
				<Logo variant="lockup" class="footer__mark" keepIds />
				<span class="pp-visually-hidden">Portage Place</span>
			</div>

			<nav class="footer__nav" aria-label="Footer">
				<ul class="footer__list" role="list">
					{
						NAV_ITEMS.map((item) => (
							<li>
								<a class="footer__link" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<address class="footer__address">
				{CONTACT.address.street}<br />
				{CONTACT.address.city}, {CONTACT.address.region} {CONTACT.address.postalCode}
			</address>
		</div>

		<p class="footer__legal">
			&copy; {year} Portage Place. A restored 1919 bakery in South Bend, Indiana.
		</p>
	</Container>
</footer>

<style lang="scss">
	.footer {
		// Was `--pp-space-section` on top to clear a CTA block, which has moved out
		// to the pages — where it can offer a secondary action the footer never
		// could. Near-symmetric now; the footer anchors, it doesn't sell.
		padding-block: var(--pp-space-2xl) var(--pp-space-l);
		// Colour comes from .pp-on-dark, which remaps the semantic aliases for
		// everything inside — the logo included, which is why it renders plaster on
		// espresso with no variant of its own.
	}

	.footer__meta {
		display: grid;
		gap: var(--pp-space-l);

		@include from('md') {
			grid-template-columns: auto 1fr auto;
			align-items: start;
			gap: var(--pp-space-xl);
		}
	}

	.footer__brand {
		display: block;
	}

	// Inherits --pp-text from .pp-on-dark, so the mark renders plaster on espresso
	// with no variant of its own — the whole point of currentColor.
	:global(.footer__mark) {
		width: clamp(10.5rem, 18vw, 13rem);
		color: var(--pp-text-strong);
	}

	.footer__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-xs) var(--pp-space-m);
		margin: 0;
		padding: 0;
	}

	.footer__link {
		font-size: var(--pp-text-s);
		color: var(--pp-text-muted);
		text-decoration: none;
		transition: color var(--pp-duration-fast) var(--pp-ease-out);

		@include focusable;

		@include hover-capable {
			&:hover {
				color: var(--pp-text-strong);
			}
		}
	}

	.footer__address {
		font-size: var(--pp-text-s);
		font-style: normal;
		line-height: var(--pp-leading-normal);
		color: var(--pp-text-muted);
	}

	.footer__legal {
		margin-block-start: var(--pp-space-xl);
		font-size: var(--pp-text-xs);
		color: var(--pp-text-muted);
	}
</style>
