---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Monogram from './Monogram.astro';

interface Props {
	person: CollectionEntry<'team'>;
}

const { person } = Astro.props;
const { name, role, org, titles, links, portrait, portraitAlt } = person.data;
const { Content } = await render(person);

// Forced line break between given and family name. Left to wrap naturally, only
// the two longest names broke, so the cards' heads sat at different heights and
// the row looked accidental. Splitting on the first space makes all four
// two-line, which is the cheapest way to get a consistent grid.
const [firstName, ...restOfName] = name.split(' ');
const lastName = restOfName.join(' ');
---

<article class="person">
	{/*
		Three columns on desktop — portrait, identity, credentials — because the card
		now spans the full container width rather than sitting in a 3-up grid. That
		buys the sketches roughly 60% more width, and it also removes the row-stretch
		bug: with one card per row there are no siblings to inflate when a bio opens.
	*/}
	<div class="person__cols">
		<div class="person__portrait-wrap">
			{
				portrait ? (
					<Image
						src={portrait}
						alt={portraitAlt ?? `Portrait of ${name}.`}
						class="person__portrait"
						widths={[160, 240, 320]}
						sizes="(min-width: 1024px) 160px, 112px"
					/>
				) : (
					<Monogram name={name} class="person__portrait" />
				)
			}
		</div>

		<div class="person__identity">
			<h3 class="person__name">
				{firstName}
				{lastName && (
					<>
						<br />
						{lastName}
					</>
				)}
			</h3>
			<p class="person__role">{role}</p>
			{org && <p class="person__org">{org}</p>}
		</div>

		{
			titles.length > 0 && (
				<ul class="person__titles" role="list">
					{titles.map((title) => (
						<li>{title}</li>
					))}
				</ul>
			)
		}
	</div>

	{/*
		A native <details> disclosure rather than a JS accordion: it is keyboard
		operable, announced correctly, and works with no script at all — which
		matters on a site that ships zero JS bundles. The bios run long and unequal,
		so collapsing them keeps four cards on a readable grid.
	*/}
	<details class="person__bio">
		<summary>
			<span class="person__bio-label person__bio-label--closed">Read bio</span>
			<span class="person__bio-label person__bio-label--open">Hide bio</span>
			<Icon name="lucide:chevron-down" aria-hidden="true" />
		</summary>
		<div class="person__bio-body">
			<Content />
		</div>
	</details>

	{
		links.length > 0 && (
			<ul class="person__links" role="list">
				{links.map((link) => (
					<li>
						<a href={link.url} target="_blank" rel="noopener noreferrer">
							{link.label}
							<Icon name="lucide:arrow-up-right" aria-hidden="true" />
							<span class="pp-visually-hidden">(opens in a new tab)</span>
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style lang="scss">
	.person {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-s);
		padding: var(--pp-space-m);
		background-color: var(--pp-raised);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);
	}

	// Stacked on mobile, three columns from `lg`. `auto` for the portrait so it
	// sizes to its own width; the two text columns share what's left.
	.person__cols {
		display: grid;
		gap: var(--pp-space-m);
		align-items: center;

		@include from('sm') {
			grid-template-columns: auto 1fr;
		}

		@include from('lg') {
			grid-template-columns: auto minmax(14rem, 1fr) minmax(14rem, 1.2fr);
			gap: var(--pp-space-xl);
		}
	}

	.person__portrait-wrap {
		display: flex;
	}

	// The sketches are line art on white. `multiply` drops the white into the card
	// so there is no visible plate edge, and it tints the graphite very slightly
	// warm against plaster — which ties them to the palette rather than sitting on
	// top of it. No circular mask for the same reason: a hard crop through the
	// shoulders would fight the open, unbounded drawing.
	:global(.person__portrait) {
		flex: none;
		width: 112px;
		height: auto;
		aspect-ratio: 1;
		mix-blend-mode: multiply;

		@include from('lg') {
			width: 160px;
		}
	}

	// Monogram fallback keeps its tile treatment.
	:global(.monogram.person__portrait) {
		width: 64px;
		border-radius: var(--pp-radius-full);
		mix-blend-mode: normal;
	}

	.person__name {
		font-size: var(--pp-text-h4);
		line-height: var(--pp-leading-snug);
		text-wrap: nowrap;
	}

	.person__role {
		margin-block-start: 0.2em;
		font-size: var(--pp-text-s);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-ink);
	}

	.person__org {
		font-size: var(--pp-text-s);
		color: var(--pp-ink-muted);
	}

	.person__titles {
		display: grid;
		gap: 0.35em;
		margin: 0;
		padding: 0;
		font-size: var(--pp-text-xs);
		line-height: var(--pp-leading-normal);
		color: var(--pp-ink-muted);
		text-wrap: pretty;

		// On mobile the titles sit under a two-column head, so they span both.
		@include until('lg') {
			@include from('sm') {
				grid-column: 1 / -1;
			}
		}
	}

	// ---------------------------------------------------------------------------
	// Disclosure
	// ---------------------------------------------------------------------------
	.person__bio {
		margin-block-start: var(--pp-space-m);
		border-block-start: 1px solid var(--pp-rule);
		padding-block-start: var(--pp-space-s);

		summary {
			display: flex;
			align-items: center;
			gap: var(--pp-space-3xs);
			width: fit-content;
			cursor: pointer;
			list-style: none;
			font-size: var(--pp-text-s);
			font-weight: var(--pp-weight-semibold);
			color: var(--pp-green-link);
			transition: color var(--pp-duration-fast) var(--pp-ease-out);

			@include hover-capable {
				&:hover {
					color: var(--pp-green-hover);
				}
			}

			// Safari still paints its own triangle without this.
			&::-webkit-details-marker {
				display: none;
			}

			@include focusable;

			:global(svg) {
				width: 16px;
				height: 16px;
				transition: rotate var(--pp-duration-base) var(--pp-ease-out);
			}
		}

		&[open] summary :global(svg) {
			rotate: 180deg;
		}
	}

	// Label swaps with state so the control always describes what it will do.
	// `display: none` rather than a font-size trick: hidden-by-display is removed
	// from the accessibility tree, whereas `font-size: 0` leaves both strings in
	// it and a screen reader announces "Read bioHide bio".
	.person__bio-label--open {
		display: none;
	}

	.person__bio[open] {
		.person__bio-label--closed {
			display: none;
		}

		.person__bio-label--open {
			display: inline;
		}
	}

	// ---------------------------------------------------------------------------
	// Smoothing the disclosure
	// ---------------------------------------------------------------------------
	// <details> has no natively animatable state: `open` flips instantly and the
	// content is added to or removed from rendering in one frame. Two layers here,
	// both zero-JS.
	//
	// 1. Modern engines: `interpolate-size: allow-keywords` makes `height: auto`
	//    interpolable, and `::details-content` gives us the box to animate. This
	//    gets a real height transition BOTH ways — open and close.
	// 2. Everywhere else: an entrance animation on the body, so the text fades and
	//    settles instead of snapping in. Closing still snaps; without JS there is
	//    no way to hold an element in the tree long enough to animate it out, and
	//    a snap-shut is far less noticeable than a snap-open.
	@supports (interpolate-size: allow-keywords) {
		.person__bio {
			interpolate-size: allow-keywords;
		}

		// `content-visibility` MUST be in this transition, and leaving it out is what
		// made the close feel violent.
		//
		// It is a discrete property, so a property not listed here changes
		// immediately: the moment `open` came off, the UA flipped it to `hidden`, the
		// bio text stopped rendering in a single frame, and what actually animated
		// was an empty box collapsing. Opening never showed the flaw, because
		// `visible` applies immediately and the growing box reveals real content —
		// which is exactly why this read as "closes harder than it opens".
		//
		// The earlier note here worried that `allow-discrete` could strand it at
		// `hidden` while block-size sits clamped at 0, leaving the bio permanently
		// unreachable. That risk is real but it is a risk of the *closed* state
		// being the only thing holding the height at zero — so the guard is below:
		// `block-size: auto` on [open] is set without the clamp being conditional on
		// the transition completing. If the transition never runs, [open] still
		// resolves to auto height and visible content, which is today's behaviour
		// minus the animation. Degrading to "unanimated" is fine; degrading to
		// "unreachable" is what we are avoiding, and this ordering avoids it.
		.person__bio::details-content {
			block-size: 0;
			overflow: hidden;
			// Exits are quicker and accelerate away — see the motion tokens.
			transition: block-size var(--pp-duration-base) var(--pp-ease-exit),
				content-visibility var(--pp-duration-base) allow-discrete;
		}

		// The entrance gets the longer duration: these bios run several hundred
		// pixels tall, and `base` across that distance is a high enough velocity to
		// read as a snap rather than an unfold.
		.person__bio[open]::details-content {
			block-size: auto;
			transition: block-size var(--pp-duration-slow) var(--pp-ease-entrance),
				content-visibility var(--pp-duration-slow) allow-discrete;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports not (interpolate-size: allow-keywords) {
			// Matches the entrance timing of the supported path above, so the two
			// code paths feel like one design rather than two.
			.person__bio[open] .person__bio-body {
				animation: bio-in var(--pp-duration-slow) var(--pp-ease-entrance) both;
			}
		}
	}

	@keyframes bio-in {
		from {
			opacity: 0;
			translate: 0 -6px;
		}
	}

	.person__bio-body {
		margin-block-start: var(--pp-space-s);
		display: grid;
		gap: var(--pp-space-s);
		font-size: var(--pp-text-s);
		line-height: var(--pp-leading-loose);
		color: var(--pp-ink);

		:global(p) {
			text-wrap: pretty;
		}

		:global(strong) {
			color: var(--pp-ink-strong);
		}
	}

	// ---------------------------------------------------------------------------
	.person__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.25em;
			font-size: var(--pp-text-xs);
			font-weight: var(--pp-weight-semibold);
			color: var(--pp-green-link);
			text-decoration: none;

			@include focusable;

			:global(svg) {
				width: 13px;
				height: 13px;
			}
		}
	}
</style>
