---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	items: CollectionEntry<'press'>[];
}

const { items } = Astro.props;

const formatDate = (date?: Date) =>
	date
		? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
				date,
			)
		: undefined;
---

<ul class="press" role="list">
	{
		items.map((item) => (
			<li class:list={['press__item', item.data.featured && 'press__item--featured']}>
				<a
					class="press__link"
					href={item.data.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="press__meta">
						{/*
							Outlet NAMES, never mastheads — reproducing news logos raises
							trademark questions and implies endorsement rather than coverage.
						*/}
						<span class="press__outlet">{item.data.outlet}</span>
						{formatDate(item.data.date) && (
							<time class="press__date" datetime={item.data.date?.toISOString()}>
								{formatDate(item.data.date)}
							</time>
						)}
					</span>

					<span class="press__headline">{item.data.headline}</span>

					{item.data.blurb && <span class="press__blurb">{item.data.blurb}</span>}

					<span class="press__cue">
						Read at {item.data.outlet}
						{/*
							The only place on the site where sending the visitor away is
							acceptable — so say where they're going, and open a new tab so we
							don't lose our own page doing it.
						*/}
						<Icon name="lucide:arrow-up-right" aria-hidden="true" />
						<span class="pp-visually-hidden">(opens in a new tab)</span>
					</span>
				</a>
			</li>
		))
	}
</ul>

<style lang="scss">
	.press {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;

		@include from('md') {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	// Featured items take the full row so the strongest coverage reads first.
	.press__item--featured {
		@include from('md') {
			grid-column: 1 / -1;
		}
	}

	.press__link {
		display: grid;
		gap: var(--pp-space-2xs);
		height: 100%;
		padding: var(--pp-space-m);
		text-decoration: none;
		color: var(--pp-ink);
		background-color: var(--pp-raised);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);

		transition: border-color var(--pp-duration-base) var(--pp-ease-out),
			box-shadow var(--pp-duration-base) var(--pp-ease-out),
			translate var(--pp-duration-base) var(--pp-ease-out);

		@include focusable;

		@include hover-capable {
			&:hover {
				border-color: var(--pp-brick-mid);
				translate: 0 -2px;
				box-shadow: var(--pp-shadow-m);
			}
		}
	}

	.press__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--pp-space-2xs);
	}

	.press__outlet {
		@include eyebrow;

		color: var(--pp-brick-dark);
	}

	.press__date {
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	.press__headline {
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-h4);
		font-weight: var(--pp-weight-semibold);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-strong);
		text-wrap: balance;
	}

	.press__blurb {
		font-size: var(--pp-text-s);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.press__cue {
		display: inline-flex;
		align-items: center;
		gap: var(--pp-space-3xs);
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-green-link);

		:global(svg) {
			width: 14px;
			height: 14px;
			transition: translate var(--pp-duration-base) var(--pp-ease-overshoot);
		}
	}

	@include hover-capable {
		.press__link:hover .press__cue :global(svg) {
			translate: 2px -2px;
		}
	}
</style>
