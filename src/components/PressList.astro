---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
	items: CollectionEntry<'press'>[];
}

const { items } = Astro.props;

const formatDate = (date?: Date) =>
	date
		? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
				date,
			)
		: undefined;
---

<ul class="press" role="list">
	{
		items.map((item) => (
			<li class="press__item">
				<a
					class="press__link"
					href={item.data.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="press__meta">
						{/*
							Outlet NAMES, never mastheads — reproducing news logos raises
							trademark questions and implies endorsement rather than coverage.
						*/}
						<span class="press__outlet">{item.data.outlet}</span>
						{formatDate(item.data.date) && (
							<time class="press__date" datetime={item.data.date?.toISOString()}>
								{formatDate(item.data.date)}
							</time>
						)}
					</span>

					<span class="press__body">
						<span class="press__headline">{item.data.headline}</span>
						{item.data.blurb && <span class="press__blurb">{item.data.blurb}</span>}
					</span>

					<span class="press__cue">
						{/*
							Visible short label + hidden context. The arrow alone was a thin
							affordance for something that navigates off-site, but "Read at
							South Bend–Elkhart Regional Partnership" would widen this column
							and squeeze the headlines. The outlet already appears in the left
							column, so the visible half loses nothing — and the accessible
							name still names the destination.
						*/}
						<span class="press__cue-text">Read article</span>
						<span class="pp-visually-hidden">at {item.data.outlet}</span>
						{/*
							The only place on the site where sending the visitor away is
							acceptable — so say where they're going, and open a new tab so we
							don't lose our own page doing it.
						*/}
						<Icon name="lucide:arrow-up-right" aria-hidden="true" />
						<span class="pp-visually-hidden">(opens in a new tab)</span>
					</span>
				</a>
			</li>
		))
	}
</ul>

<style lang="scss">
	// One item per row, deliberately.
	//
	// A two-column grid made every card as tall as the tallest thing beside it,
	// so seven pieces of coverage of wildly different headline length read as
	// seven differently-sized boxes. One per row means every row is the same
	// shape, and the eye can run down the outlet column like an index.
	.press {
		display: grid;
		gap: var(--pp-space-xs);
		margin: 0;
		padding: 0;
	}

	// The outlet column is fixed-width rather than auto so the headlines all
	// start on the same vertical line — with `auto` the longest outlet name
	// ("South Bend–Elkhart Regional Partnership") would set the indent for
	// every row.
	.press__link {
		display: grid;
		gap: var(--pp-space-2xs);
		padding: var(--pp-space-m);
		text-decoration: none;
		color: var(--pp-ink);
		// Plaster, per the client 2026-08-25 — was `--pp-raised`, which inverts with
		// section tone and had turned these limestone once the section went plaster.
		// Pinned so the card colour no longer follows the section.
		background-color: var(--pp-plaster);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);

		transition: border-color var(--pp-duration-base) var(--pp-ease-out),
			box-shadow var(--pp-duration-base) var(--pp-ease-out),
			translate var(--pp-duration-base) var(--pp-ease-out);

		@include from('md') {
			grid-template-columns: 11rem minmax(0, 1fr) auto;
			align-items: center;
			column-gap: var(--pp-space-m);
			row-gap: 0;
		}

		@include focusable;

		@include hover-capable {
			&:hover {
				border-color: var(--pp-brick-mid);
				translate: 0 -2px;
				box-shadow: var(--pp-shadow-m);
			}
		}
	}

	.press__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--pp-space-2xs);

		// Stacked from md so the outlet column stays narrow — side by side, the
		// two longest names plus a date overflow 11rem and force a ragged wrap.
		@include from('md') {
			flex-direction: column;
			gap: 2px;
		}
	}

	.press__outlet {
		@include eyebrow;

		color: var(--pp-brick-dark);
	}

	.press__date {
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	.press__body {
		display: grid;
		gap: 2px;
	}

	.press__headline {
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-h4);
		font-weight: var(--pp-font-display-weight);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-strong);
		text-wrap: balance;

		// A step down once these become rows. At h4 all but the shortest headline
		// wrapped to two lines, so the rows differed by a whole line of type; at
		// lede most sit on one line and the list settles. It is also the more
		// honest size for what this now is — an index, not seven feature cards.
		@include from('md') {
			font-size: var(--pp-text-lede);
		}
	}

	.press__blurb {
		font-size: var(--pp-text-s);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.press__cue {
		display: inline-flex;
		align-items: center;
		gap: var(--pp-space-3xs);
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-green-link);

		@include from('md') {
			margin-block-start: 0;
		}

		:global(svg) {
			width: 14px;
			height: 14px;
			transition: translate var(--pp-duration-base) var(--pp-ease-overshoot);
		}
	}

	// The label used to be hidden from `md` up, leaving desktop with a bare arrow.
	// That was the wrong trade: an arrow on its own is a weak signal for a link
	// that leaves the site, and this is the one place on the site where we send a
	// visitor away deliberately. It now reads "Read article" at every width, with
	// the outlet name carried in adjacent visually-hidden text so the column stays
	// narrow and the accessible name stays complete.

	@include hover-capable {
		.press__link:hover .press__cue :global(svg) {
			translate: 2px -2px;
		}
	}
</style>
