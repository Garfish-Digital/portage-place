---
import { STATS } from '../config/site';
---

{/*
	A <dl> rather than divs: each stat is genuinely a term/description pair, and a
	screen reader then announces "Space sizes, 200 to 1,800 sq ft" instead of two
	unrelated fragments. The value comes first visually but second in the DOM —
	<dt> must precede <dd> — so `flex-direction: column-reverse` does the swap
	without breaking the reading order.
*/}
<dl class="stats">
	{
		STATS.map((stat) => (
			<div class="stat">
				<dt class="stat__label">{stat.label}</dt>
				<dd class="stat__value">
					{stat.value}
					{'unit' in stat && stat.unit && <span class="stat__unit">{stat.unit}</span>}
				</dd>
			</div>
		))
	}
</dl>

<style lang="scss">
	.stats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--pp-space-m) var(--pp-space-s);
		margin: 0;
		// Halved from `--pp-space-l` (32px). Client asked for a more slender strip —
		// see also the value's step down from h3 to h4 below. Together they take the
		// band from ~117px to ~78px without touching the horizontal rhythm.
		padding-block: var(--pp-space-2xs);
		border-block: 1px solid var(--pp-rule);

		// ONE COLUMN PER STAT, however many there are — `grid-auto-flow: column`
		// derives the count from the content instead of restating it.
		//
		// It was `repeat(5, auto)`, written when a fifth stat ("20 private offices")
		// was live. That stat is currently commented out in site.ts, so the grid
		// went on reserving a fifth track, it resolved to zero width, and
		// `space-between` dutifully pushed that empty track to the right edge —
		// parking all the free space at the end and bunching the four real stats
		// to the left. The symptom looked like `flex-start`; the cause was a column
		// count that had stopped matching the data.
		@include from('md') {
			grid-auto-flow: column;
			grid-template-columns: none;
			justify-content: space-evenly;
			gap: var(--pp-space-l);
		}

		// Equal cells, but only once there is room for them. At 768px four equal
		// columns come to 154px each, and "200–1,800 sq ft" needs roughly 190 at
		// this type size — with `text-wrap: nowrap` on the value that overflows
		// rather than wraps. By 1024px a cell is 216px and the widest stat fits
		// with margin to spare, so the strip can switch to a true even rhythm.
		//
		// Below that, `space-evenly` over content-sized tracks gets the same
		// distribution without ever risking the overflow.
		@include from('lg') {
			grid-auto-columns: 1fr;
		}
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		gap: var(--pp-space-3xs);

		// Centre the label under its value. The two are very different widths —
		// "Suite sizes" against "200–1,800 sq ft" — so left-aligning them left every
		// label hanging off the start of a much wider number, which read as
		// accidental rather than composed.
		//
		// ⚠️ MOBILE STAYS LEFT-ALIGNED, and this was tried the other way. Centring
		// the 2-up grid was built and rejected on sight (2026-08-22): at that size
		// the stats read as a list rather than a band, and a list wants a shared
		// left edge — four centred items over two ragged columns look scattered.
		//
		// Note there is no `justify-content` fix available on mobile either: the
		// 2-up tracks are `1fr` and already fill the row, so there is no free space
		// between them to distribute. Cell-content alignment is the only lever
		// there, and left is the one we want.
		@include from('md') {
			align-items: center;
			text-align: center;
		}
	}

	.stat__value {
		margin: 0;
		font-family: var(--pp-font-display);
		// h4 (24→29px), down one step from h3 (29→36px). At h3 the values sat within
		// a few pixels of the page's h2 (34→46px) at mobile widths, so a stat read
		// with the weight of a section heading. h4 keeps the number as the loudest
		// thing in the strip without competing with the headings around it.
		font-size: var(--pp-text-lede);
		font-weight: var(--pp-weight-semibold);
		line-height: 1;
		letter-spacing: var(--pp-tracking-tight);
		color: var(--pp-ink-strong);
		text-wrap: nowrap;
	}

	.stat__unit {
		font-size: 0.55em;
		font-weight: var(--pp-weight-normal);
		color: var(--pp-ink-muted);
		margin-inline-start: 0.1em;
	}

	.stat__label {
		@include eyebrow;

		font-size: var(--pp-text-2xs);
		color: var(--pp-ink-muted);
	}
</style>
