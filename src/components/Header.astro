---
import { Icon } from 'astro-icon/components';
import Container from './primitives/Container.astro';
import Logo from './Logo.astro';
import { NAV_ITEMS } from '../config/nav';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="header" data-header>
	<Container as="div" class="header__inner">
		<a class="header__brand" href="/">
			{/*
				Icon + live text, not the full lockup: the lockup stacks PORTAGE over
				PLACE and would need ~90px of height in a 72px bar. The name stays as
				real text because "remember the name" is the client's stated goal, and
				because it gives the link its accessible name — the lockup's wordmark is
				outlined vector, which no screen reader can read.
			*/}
			<Logo variant="icon" class="header__mark" />
			<Logo variant="wordmark" class="header__wordmark" />
			{/*
				The wordmark is outlined vector, not text, so it cannot name the link.
				This carries the accessible name that the rendered PORTAGE / PLACE
				used to supply as live type.
			*/}
			<span class="pp-visually-hidden">Portage Place</span>
		</a>

		<nav class="header__nav" aria-label="Primary">
			<ul class="header__list" role="list">
				{
					NAV_ITEMS.map((item) => (
						<li>
							<a
								class="header__link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.shortLabel ?? item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			class="header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="header-mobile-nav"
			data-nav-toggle
		>
			<Icon name="lucide:menu" class="header__toggle-icon header__toggle-icon--open" aria-hidden="true" />
			<Icon name="lucide:x" class="header__toggle-icon header__toggle-icon--close" aria-hidden="true" />
			<span class="pp-visually-hidden">Menu</span>
		</button>
	</Container>

	{/*
		Mobile nav is a sibling panel rather than a duplicate <nav aria-label="Primary">
		— two nav landmarks with the same name is a screen-reader smell.

		No `hidden` attribute: the panel animates in and out of `display: none` via
		@starting-style + allow-discrete, and `hidden` would win over the open
		state's `display: block` and kill the transition. `display: none` already
		removes it from both the tab order and the accessibility tree, so nothing is
		lost — see the style block.

		`.pp-on-dark` is the surface context, not a modifier: it remaps the semantic
		aliases so the links, the muted text and the current-page colour all resolve
		correctly on espresso with no inverse variants of their own.
	*/}
	<div class="header__panel pp-on-dark" id="header-mobile-nav" data-nav-panel>
		<ul class="header__panel-list" role="list">
			{
				NAV_ITEMS.map((item, index) => (
					<li class="header__panel-item" style={`--i: ${index}`}>
						<a
							class="header__panel-link"
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	// Progressive enhancement: without JS the panel stays hidden and the desktop
	// nav is still reachable at >=1024px. Phase 2 should add a no-JS fallback for
	// narrow viewports (a <details> disclosure) before this ships to production.
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
	const header = document.querySelector<HTMLElement>('[data-header]');

	if (toggle && panel && header) {
		// No `panel.hidden` here by design. The panel's open/closed state is a class
		// on the header, so CSS owns `display` and can transition it discretely via
		// @starting-style + allow-discrete. Setting `hidden` as well would override
		// the open state's `display: block` and the panel would never appear.
		// `display: none` when closed already keeps it out of the tab order and the
		// accessibility tree.
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			header.classList.toggle('is-nav-open', open);
			// The bar has to be opaque while the panel hangs off it — over a hero the
			// transparent bar would leave the toggle sitting on the photograph with
			// the panel's own edge starting a few pixels below.
			if (open) header.classList.add('is-solid');
			// Lock the page behind the panel, but only while it's actually open.
			document.documentElement.style.overflow = open ? 'hidden' : '';
		};

		const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

		toggle.addEventListener('click', () => setOpen(!isOpen()));

		// Click-outside. The panel is now an inset card with the page visible around
		// it, so tapping beside it is the first thing anyone tries.
		//
		// `pointerdown` rather than `click` so the menu is already going away as the
		// finger lands. The toggle is excluded because its own handler runs after
		// this one — without the guard, opening would immediately close again.
		document.addEventListener('pointerdown', (event) => {
			if (!isOpen()) return;
			const target = event.target as Node;
			if (panel.contains(target) || toggle.contains(target)) return;
			setOpen(false);
		});

		// Esc closes and returns focus to the control that opened it.
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		// Closing on resize past the desktop breakpoint prevents the panel being
		// left open-but-invisible, which strands focus in hidden content.
		const desktop = window.matchMedia('(min-width: 1024px)');
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}

	// The header is transparent over the hero and solid once the hero has passed
	// under it.
	//
	// An IntersectionObserver on the hero rather than a scroll threshold: hero
	// heights differ per page (display vs page size, and svh varies with mobile
	// browser chrome), so any fixed pixel value would be wrong somewhere. Shrinking
	// the root's top edge by the header height makes the hero stop intersecting at
	// exactly the moment its base slides under the bar.
	//
	// No hero on the page — or no IntersectionObserver — means solid from the
	// start, which is also the correct fallback: light nav on a light page would be
	// unreadable.
	const headerEl = document.querySelector<HTMLElement>('[data-header]');
	const hero = document.querySelector<HTMLElement>('[data-hero]');

	if (headerEl) {
		if (!hero || !('IntersectionObserver' in window)) {
			headerEl.classList.add('is-solid');
		} else {
			const headerHeight = () => headerEl.offsetHeight;
			let observer: IntersectionObserver | null = null;

			const watch = () => {
				observer?.disconnect();
				observer = new IntersectionObserver(
					([entry]) => headerEl.classList.toggle('is-solid', !entry.isIntersecting),
					{ rootMargin: `-${headerHeight()}px 0px 0px 0px`, threshold: 0 },
				);
				observer.observe(hero);
			};

			watch();
			// The header can change height (the wordmark wraps at some widths), which
			// would leave the rootMargin stale and the flip firing early or late.
			if ('ResizeObserver' in window) {
				new ResizeObserver(watch).observe(headerEl);
			}
		}
	}
</script>

<style lang="scss">
	// Transparent at rest, sitting over the hero; espresso once the hero has
	// scrolled past. The hero pulls itself up under this by --pp-header-h.
	.header {
		position: sticky;
		inset-block-start: 0;
		z-index: var(--pp-z-header);
		background-color: transparent;
		// Rule drawn as an inset shadow, not a border: a 1px border adds to the
		// header's height, and the hero tucks up by exactly --pp-header-h — so the
		// border left a 1px plaster line across the top of every hero.
		transition: background-color var(--pp-duration-base) var(--pp-ease-out),
			box-shadow var(--pp-duration-base) var(--pp-ease-out);
	}

	// Set by the observer once the hero's base passes under the header — and the
	// default for any page with no hero at all, so the nav is never light text on
	// a light page.
	.header.is-solid {
		background-color: var(--pp-espresso);
		box-shadow: inset 0 -1px 0 var(--pp-rule-inverse), var(--pp-shadow-s);
	}

	:global(.header__inner) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--pp-space-m);
		min-height: var(--pp-header-h);
	}

	// ---------------------------------------------------------------------------
	// Brand
	// ---------------------------------------------------------------------------
	// The client's mark is designed to sit on black, so it keeps its own plaque in
	// both header states rather than adopting the bar's colour. Square corners:
	// their asset is a hard-edged rectangle, not a rounded chip.
	//
	// The plaque is --pp-ink-strong (#16130F) and the bar it sits on when scrolled
	// is espresso (#322F2C) — about 1.6:1 apart, so the plaster hairline is what
	// keeps its edge defined in the solid state.
	// Both parts of the brand scale from one number, so the icon and the wordmark
	// can never drift out of proportion. 30px on phones and 38px from `sm`: at
	// 390px the brand had only 61px of slack before the toggle, and the wordmark
	// is ~2.5x wider than the live text it replaces.
	.header__brand {
		--pp-header-mark-h: 34px;

		@include from('sm') {
			--pp-header-mark-h: 38px;
		}

		display: inline-flex;
		align-items: center;
		gap: var(--pp-space-xs);
		padding: var(--pp-space-2xs) var(--pp-space-s);
		text-decoration: none;
		color: var(--pp-plaster);
		background-color: var(--pp-ink-strong);
		border: 1px solid var(--pp-plaster);

		@include focusable;
	}

	// 38px tall → ~67px wide at the mark's 1.76:1 ratio. Size testing put the
	// legibility floor at roughly 40px WIDE, where the diagonal channel between
	// the two forms closes up; 67px is comfortably clear of it. The old 34px
	// square placeholder was well below that line.
	:global(.header__mark) {
		height: var(--pp-header-mark-h);
		width: auto;
		flex: none;
		// currentColor on the inlined SVG — plaster on the plaque.
		color: var(--pp-plaster);
	}

	// The client's own wordmark rather than Public Sans set to look like it.
	// PORTAGE over rule–PLACE–rule, exactly as drawn, just placed beside the icon
	// instead of under it — a stacked lockup would need ~90px of height in a 72px
	// bar. Nothing is redrawn: the paths are the master's, cropped to a tight box.
	//
	// Height is driven off the icon rather than set independently, so the two can
	// never drift apart. Matched 1:1 rather than at the master's 0.814 ratio:
	// that ratio is right at lockup size, but in a 72px bar it put PLACE at a
	// 7.9px cap and the rules at 0.84px, and a sub-pixel stroke gets dithered to
	// pale grey by the rasteriser. At 1:1 the rules land on ~1.04px.
	:global(.header__wordmark) {
		height: var(--pp-header-mark-h);
		width: auto;
		flex: none;
		color: var(--pp-plaster);
	}

	// The two rules are a 3-unit stroke in a 109.9-unit box, so they scale to
	// 1.04px at desktop and 0.93px on a phone. Both are sub-pixel, and a sub-pixel
	// stroke gets spread across two rows and dimmed — measured at 1x DPR the rules
	// came out 133/255 against the plaster they are supposed to match. Pinning
	// them to 1.25px puts that at 150/255 and holds at every size.
	//
	// Invisible on a 2x display, which is why this looks fine on a laptop and thin
	// on an external monitor. Nothing is redrawn: this is a stroke width on two
	// straight lines, and no letterform is touched.
	//
	// Matched on `stroke` rather than on an id: the header strips ids, because the
	// footer's draw animation owns #rules / #rule-left / #rule-right and two of
	// each on one page is invalid HTML. Only the rules are stroked — every
	// letterform is filled — so the attribute IS the selector.
	:global(.header__wordmark path[stroke]) {
		vector-effect: non-scaling-stroke;
		stroke-width: 1.25px;
	}

	// ---------------------------------------------------------------------------
	// Desktop nav
	// ---------------------------------------------------------------------------
	.header__nav {
		display: none;

		@include from('lg') {
			display: block;
		}
	}

	.header__list {
		display: flex;
		align-items: center;
		gap: var(--pp-space-m);
		margin: 0;
		padding: 0;
	}

	.header__link {
		@include eyebrow;

		position: relative;
		display: block;
		padding-block: var(--pp-space-2xs);
		// One colour in both states: the bar is either a dark-scrimmed photograph
		// or espresso, so plaster reads on both and nothing needs to flip.
		color: var(--pp-plaster);
		text-decoration: none;
		transition: color var(--pp-duration-fast) var(--pp-ease-out);

		@include focusable;

		// Bronze underline as the active/hover marker. Bronze can't carry text
		// (3.48:1), but as a 2px rule it's non-text UI and clears 3:1 comfortably —
		// which is why the label itself stays ink.
		&::after {
			content: '';
			position: absolute;
			inset-block-end: -2px;
			inset-inline: 0;
			height: 2px;
			background-color: var(--pp-limestone-deep);
			scale: 0 1;
			transform-origin: left center;
			transition: scale var(--pp-duration-base) var(--pp-ease-out);
		}

		@include hover-capable {
			&:hover::after {
				scale: 1 1;
			}
		}

		&[aria-current='page'] {
			color: #fff;

			&::after {
				scale: 1 1;
			}
		}
	}

	// ---------------------------------------------------------------------------
	// Mobile toggle + panel
	// ---------------------------------------------------------------------------
	.header__toggle {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-inline-end: calc(var(--pp-space-2xs) * -1);
		color: var(--pp-plaster);
		border-radius: var(--pp-radius-m);

		@include focusable;

		@include from('lg') {
			display: none;
		}
	}

	.header__toggle-icon {
		grid-area: 1 / 1;
		width: 22px;
		height: 22px;
		transition: opacity var(--pp-duration-fast) var(--pp-ease-out),
			rotate var(--pp-duration-base) var(--pp-ease-out);
	}

	.header__toggle-icon--close {
		opacity: 0;
		rotate: -45deg;
	}

	.header.is-nav-open {
		.header__toggle-icon--open {
			opacity: 0;
			rotate: 45deg;
		}

		.header__toggle-icon--close {
			opacity: 1;
			rotate: 0deg;
		}
	}

	// ---------------------------------------------------------------------------
	// Mobile panel
	// ---------------------------------------------------------------------------
	// An inset card anchored under the toggle, not a full-width slab. Full width
	// took 100% of the viewport and 48% of its height on a 390px phone, which read
	// as a takeover rather than a menu; anchoring it to the button that opened it
	// is the thing that makes it feel attached rather than imposed.
	//
	// Espresso rather than plaster because the bar is forced solid while the panel
	// is open — a light panel hanging off a dark bar met at a hard seam and read as
	// two materials colliding. As one dark form it reads as the bar extending.
	//
	// `position: absolute` against the header (which is sticky, so it establishes
	// the containing block) keeps the panel pinned to the bar while the page is
	// locked behind it.
	.header__panel {
		position: absolute;
		inset-block-start: 100%;
		inset-inline-end: var(--pp-gutter);
		z-index: 1;

		width: min(20rem, calc(100vw - 2 * var(--pp-gutter)));
		margin-block-start: var(--pp-space-2xs);
		padding: var(--pp-space-2xs) var(--pp-space-s);

		// Five items come to 298px, so this never bites today. It is here because
		// the page behind is scroll-locked while the panel is open: without it, a
		// sixth or seventh nav item would push rows off the bottom of a short
		// screen with no way to reach them.
		max-block-size: calc(100svh - var(--pp-header-h) - var(--pp-space-l));
		overflow-y: auto;
		overscroll-behavior: contain;

		background-color: var(--pp-espresso);
		border: 1px solid var(--pp-rule-inverse);
		border-radius: var(--pp-radius-l);
		box-shadow: var(--pp-shadow-l);

		// `display` is not interpolable, so it needs `allow-discrete` to flip at the
		// right end of the transition — at the start when opening, at the end when
		// closing, which is what lets the panel animate *out* instead of vanishing.
		// Same mechanism as ContactModal; browsers without it get today's instant
		// appearance, which is a clean degrade rather than a broken one.
		display: none;
		opacity: 0;
		scale: 0.97;
		translate: 0 -6px;
		transform-origin: top right;
		transition: opacity var(--pp-duration-base) var(--pp-ease-entrance),
			scale var(--pp-duration-base) var(--pp-ease-entrance),
			translate var(--pp-duration-base) var(--pp-ease-entrance),
			display var(--pp-duration-base) allow-discrete;

	}

	// Guarded with `until` rather than giving the closed state `display: none
	// !important` at lg: the open rule is more specific, so the breakpoint has to
	// sit on the rule that would otherwise win.
	@include until('lg') {
		.header.is-nav-open .header__panel {
			display: block;
			opacity: 1;
			scale: 1;
			translate: 0 0;

			// The from-state for an element entering `display: block`. Without it the
			// panel would pop straight to its open values with nothing to travel from.
			@starting-style {
				opacity: 0;
				scale: 0.97;
				translate: 0 -6px;
			}
		}
	}

	.header__panel-list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
	}

	// Each row arrives a beat after the one above it. `--i` is set per item in the
	// markup, so the stagger is arithmetic rather than five hand-written rules —
	// and it costs no JS.
	//
	// The delay is deliberately NOT part of the reduced-motion story: the duration
	// tokens collapse to 1ms there, but a delay would still hold each row back, so
	// it is zeroed explicitly below.
	.header__panel-item {
		opacity: 0;
		translate: 0 -4px;
		transition: opacity var(--pp-duration-fast) var(--pp-ease-out),
			translate var(--pp-duration-fast) var(--pp-ease-out);
	}

	.header.is-nav-open .header__panel-item {
		opacity: 1;
		translate: 0 0;
		transition-delay: calc(60ms + var(--i) * 40ms);

		// The rows need their own from-state, not just the panel. They are not
		// individually `display: none` — they simply aren't rendered while their
		// parent is — so on open they go straight from unrendered to final with no
		// previous value to interpolate from, and the stagger silently does
		// nothing. Measured: without this the first row read opacity 1 at +30ms.
		@starting-style {
			opacity: 0;
			translate: 0 -4px;
		}
	}

	@include reduced-motion {
		.header.is-nav-open .header__panel-item {
			transition-delay: 0ms;
		}
	}

	.header__panel-link {
		display: flex;
		align-items: center;
		gap: var(--pp-space-xs);
		// 56px rather than the old 72: with the panel no longer eating half the
		// screen the rows do not need to carry it, and 56 is still well clear of the
		// 44px minimum target (SC 2.5.8).
		min-height: 56px;
		padding-block: var(--pp-space-2xs);
		border-block-end: 1px solid var(--pp-rule-inverse);
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-lede);
		color: var(--pp-text);
		text-decoration: none;

		@include focusable(-2px);

		// Bronze marks the current page, but as a RULE rather than as lettering:
		// bronze is 3.51:1 on espresso, which clears the 3:1 non-text threshold and
		// fails the 4.5:1 text one. The text colour comes from `.pp-on-dark`, which
		// remaps --pp-green-link to --pp-green-on-dark (6.68:1). The unremapped
		// token would have been 1.91:1 — invisible.
		&[aria-current='page'] {
			color: var(--pp-green-link);

			&::before {
				content: '';
				flex: none;
				width: 3px;
				align-self: stretch;
				margin-block: var(--pp-space-2xs);
				background-color: var(--pp-bronze);
				border-radius: var(--pp-radius-s);
			}
		}
	}

	.header__panel-list li:last-child .header__panel-link {
		border-block-end: 0;
	}
</style>
