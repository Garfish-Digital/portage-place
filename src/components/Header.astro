---
import { Icon } from 'astro-icon/components';
import Container from './primitives/Container.astro';
import Logo from './Logo.astro';
import { NAV_ITEMS } from '../config/nav';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="header" data-header>
	<Container as="div" class="header__inner">
		<a class="header__brand" href="/">
			{/*
				Icon + live text, not the full lockup: the lockup stacks PORTAGE over
				PLACE and would need ~90px of height in a 72px bar. The name stays as
				real text because "remember the name" is the client's stated goal, and
				because it gives the link its accessible name — the lockup's wordmark is
				outlined vector, which no screen reader can read.
			*/}
			<Logo variant="icon" class="header__mark" />
			<span class="header__wordmark">Portage Place</span>
		</a>

		<nav class="header__nav" aria-label="Primary">
			<ul class="header__list" role="list">
				{
					NAV_ITEMS.map((item) => (
						<li>
							<a
								class="header__link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.shortLabel ?? item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button
			class="header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="header-mobile-nav"
			data-nav-toggle
		>
			<Icon name="lucide:menu" class="header__toggle-icon header__toggle-icon--open" aria-hidden="true" />
			<Icon name="lucide:x" class="header__toggle-icon header__toggle-icon--close" aria-hidden="true" />
			<span class="pp-visually-hidden">Menu</span>
		</button>
	</Container>

	{/*
		Mobile nav is a sibling panel rather than a duplicate <nav aria-label="Primary">
		— two nav landmarks with the same name is a screen-reader smell. It's hidden
		with `hidden` (not just CSS) so it stays out of the tab order when closed.
	*/}
	<div class="header__panel" id="header-mobile-nav" hidden data-nav-panel>
		<Container as="div">
			<ul class="header__panel-list" role="list">
				{
					NAV_ITEMS.map((item) => (
						<li>
							<a
								class="header__panel-link"
								href={item.href}
								aria-current={isCurrent(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</Container>
	</div>
</header>

<script>
	// Progressive enhancement: without JS the panel stays hidden and the desktop
	// nav is still reachable at >=1024px. Phase 2 should add a no-JS fallback for
	// narrow viewports (a <details> disclosure) before this ships to production.
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
	const header = document.querySelector<HTMLElement>('[data-header]');

	if (toggle && panel && header) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
			header.classList.toggle('is-nav-open', open);
			// The panel is plaster; a transparent bar above it would leave the nav
			// links reading as light text on a light surface.
			if (open) header.classList.add('is-solid');
			// Lock the page behind the panel, but only while it's actually open.
			document.documentElement.style.overflow = open ? 'hidden' : '';
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Esc closes and returns focus to the control that opened it.
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		// Closing on resize past the desktop breakpoint prevents the panel being
		// left open-but-invisible, which strands focus in hidden content.
		const desktop = window.matchMedia('(min-width: 1024px)');
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}

	// The header is transparent over the hero and solid once the hero has passed
	// under it.
	//
	// An IntersectionObserver on the hero rather than a scroll threshold: hero
	// heights differ per page (display vs page size, and svh varies with mobile
	// browser chrome), so any fixed pixel value would be wrong somewhere. Shrinking
	// the root's top edge by the header height makes the hero stop intersecting at
	// exactly the moment its base slides under the bar.
	//
	// No hero on the page — or no IntersectionObserver — means solid from the
	// start, which is also the correct fallback: light nav on a light page would be
	// unreadable.
	const headerEl = document.querySelector<HTMLElement>('[data-header]');
	const hero = document.querySelector<HTMLElement>('[data-hero]');

	if (headerEl) {
		if (!hero || !('IntersectionObserver' in window)) {
			headerEl.classList.add('is-solid');
		} else {
			const headerHeight = () => headerEl.offsetHeight;
			let observer: IntersectionObserver | null = null;

			const watch = () => {
				observer?.disconnect();
				observer = new IntersectionObserver(
					([entry]) => headerEl.classList.toggle('is-solid', !entry.isIntersecting),
					{ rootMargin: `-${headerHeight()}px 0px 0px 0px`, threshold: 0 },
				);
				observer.observe(hero);
			};

			watch();
			// The header can change height (the wordmark wraps at some widths), which
			// would leave the rootMargin stale and the flip firing early or late.
			if ('ResizeObserver' in window) {
				new ResizeObserver(watch).observe(headerEl);
			}
		}
	}
</script>

<style lang="scss">
	// Transparent at rest, sitting over the hero; espresso once the hero has
	// scrolled past. The hero pulls itself up under this by --pp-header-h.
	.header {
		position: sticky;
		inset-block-start: 0;
		z-index: var(--pp-z-header);
		background-color: transparent;
		// Rule drawn as an inset shadow, not a border: a 1px border adds to the
		// header's height, and the hero tucks up by exactly --pp-header-h — so the
		// border left a 1px plaster line across the top of every hero.
		transition: background-color var(--pp-duration-base) var(--pp-ease-out),
			box-shadow var(--pp-duration-base) var(--pp-ease-out);
	}

	// Set by the observer once the hero's base passes under the header — and the
	// default for any page with no hero at all, so the nav is never light text on
	// a light page.
	.header.is-solid {
		background-color: var(--pp-espresso);
		box-shadow: inset 0 -1px 0 var(--pp-rule-inverse), var(--pp-shadow-s);
	}

	:global(.header__inner) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--pp-space-m);
		min-height: var(--pp-header-h);
	}

	// ---------------------------------------------------------------------------
	// Brand
	// ---------------------------------------------------------------------------
	// The client's mark is designed to sit on black, so it keeps its own plaque in
	// both header states rather than adopting the bar's colour. Square corners:
	// their asset is a hard-edged rectangle, not a rounded chip.
	//
	// The plaque is --pp-ink-strong (#16130F) and the bar it sits on when scrolled
	// is espresso (#322F2C) — about 1.6:1 apart, so the plaster hairline is what
	// keeps its edge defined in the solid state.
	.header__brand {
		display: inline-flex;
		align-items: center;
		gap: var(--pp-space-xs);
		padding: var(--pp-space-2xs) var(--pp-space-s);
		text-decoration: none;
		color: var(--pp-plaster);
		background-color: var(--pp-ink-strong);
		border: 1px solid var(--pp-plaster);

		@include focusable;
	}

	// 38px tall → ~67px wide at the mark's 1.76:1 ratio. Size testing put the
	// legibility floor at roughly 40px WIDE, where the diagonal channel between
	// the two forms closes up; 67px is comfortably clear of it. The old 34px
	// square placeholder was well below that line.
	:global(.header__mark) {
		height: 38px;
		width: auto;
		flex: none;
		// currentColor on the inlined SVG — plaster on the plaque.
		color: var(--pp-plaster);
	}

	// Public Sans letter-spaced caps rather than Fraunces. The mark's own
	// lettering is a geometric sans, and setting the name in a serif right next
	// to it reads as two competing voices. This echoes the logo instead.
	.header__wordmark {
		font-family: var(--pp-font-body);
		font-size: var(--pp-text-xs);
		font-weight: var(--pp-weight-semibold);
		letter-spacing: var(--pp-tracking-caps);
		text-transform: uppercase;
		line-height: 1.2;
		color: var(--pp-plaster);
	}

	// ---------------------------------------------------------------------------
	// Desktop nav
	// ---------------------------------------------------------------------------
	.header__nav {
		display: none;

		@include from('lg') {
			display: block;
		}
	}

	.header__list {
		display: flex;
		align-items: center;
		gap: var(--pp-space-m);
		margin: 0;
		padding: 0;
	}

	.header__link {
		@include eyebrow;

		position: relative;
		display: block;
		padding-block: var(--pp-space-2xs);
		// One colour in both states: the bar is either a dark-scrimmed photograph
		// or espresso, so plaster reads on both and nothing needs to flip.
		color: var(--pp-plaster);
		text-decoration: none;
		transition: color var(--pp-duration-fast) var(--pp-ease-out);

		@include focusable;

		// Bronze underline as the active/hover marker. Bronze can't carry text
		// (3.48:1), but as a 2px rule it's non-text UI and clears 3:1 comfortably —
		// which is why the label itself stays ink.
		&::after {
			content: '';
			position: absolute;
			inset-block-end: -2px;
			inset-inline: 0;
			height: 2px;
			background-color: var(--pp-limestone-deep);
			scale: 0 1;
			transform-origin: left center;
			transition: scale var(--pp-duration-base) var(--pp-ease-out);
		}

		@include hover-capable {
			&:hover::after {
				scale: 1 1;
			}
		}

		&[aria-current='page'] {
			color: #fff;

			&::after {
				scale: 1 1;
			}
		}
	}

	// ---------------------------------------------------------------------------
	// Mobile toggle + panel
	// ---------------------------------------------------------------------------
	.header__toggle {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-inline-end: calc(var(--pp-space-2xs) * -1);
		color: var(--pp-plaster);
		border-radius: var(--pp-radius-m);

		@include focusable;

		@include from('lg') {
			display: none;
		}
	}

	.header__toggle-icon {
		grid-area: 1 / 1;
		width: 22px;
		height: 22px;
		transition: opacity var(--pp-duration-fast) var(--pp-ease-out),
			rotate var(--pp-duration-base) var(--pp-ease-out);
	}

	.header__toggle-icon--close {
		opacity: 0;
		rotate: -45deg;
	}

	.header.is-nav-open {
		.header__toggle-icon--open {
			opacity: 0;
			rotate: 45deg;
		}

		.header__toggle-icon--close {
			opacity: 1;
			rotate: 0deg;
		}
	}

	.header__panel {
		border-block-start: 1px solid var(--pp-rule);
		background-color: var(--pp-plaster);
		padding-block: var(--pp-space-s) var(--pp-space-l);

		@include from('lg') {
			display: none;
		}
	}

	.header__panel-list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
	}

	.header__panel-link {
		display: block;
		padding-block: var(--pp-space-s);
		border-block-end: 1px solid var(--pp-rule);
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-h4);
		color: var(--pp-ink-strong);
		text-decoration: none;

		@include focusable(-2px);

		&[aria-current='page'] {
			color: var(--pp-green-link);
		}
	}

	.header__panel-list li:last-child .header__panel-link {
		border-block-end: 0;
	}
</style>
