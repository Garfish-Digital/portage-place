---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from './primitives/Container.astro';

/**
 * Photographic page hero.
 *
 * ── The scrim ──────────────────────────────────────────────────────────────
 * Two layers, and the split is the whole point.
 *
 * A single full-image gradient has to be dark enough at the text to guarantee
 * contrast, which means it is also dark everywhere above the text — muting the
 * building for no benefit. The first version of this reached 92% espresso at the
 * bottom when measurement showed the five hero photographs need between 41% and
 * 63% for plaster text at 4.5:1.
 *
 * So: a light wash over the whole image for mood, and a separate veil that wraps
 * only the text and therefore sizes itself to the copy. The veil's fade happens
 * inside its top padding, so text always sits in the fully-opaque part rather
 * than somewhere on the ramp — which is what went wrong when the gradient was
 * pinned to the image instead of the content.
 *
 * Composited, the text zone lands near 76% — clear of the worst photograph here
 * (63%) and of a blown-white worst case (70%), so a replacement photograph can't
 * silently break it.
 */
interface Props {
	image: ImageMetadata;
	/**
	 * Portrait crop for phones (2:3, 1440x2160). ART DIRECTION, not a smaller
	 * copy — see the note above the <picture> below for why resizing the
	 * landscape frame could not solve this.
	 */
	mobileImage?: ImageMetadata;
	alt: string;
	eyebrow?: string;
	title: string;
	lede?: string;
	/** `display` is the homepage's larger treatment; `page` is for inner pages. */
	size?: 'display' | 'page';
	/** Only the LCP hero on a page should be eager. */
	priority?: boolean;
	/** Focal point of the LANDSCAPE frame, e.g. "center 40%". */
	position?: string;
	/** Focal point of the portrait crop. Purpose-composed, so centred by default. */
	mobilePosition?: string;
	/**
	 * Veil strength over the text block, 0–100. MEASURED, not chosen —
	 * `node scripts/hero-scrim.mjs` prints the value for each photograph.
	 *
	 * One global number made every page as dark as the darkest photograph. These
	 * heroes need between 44% and 63%, so a single value had to sit at 69% and
	 * eight of the ten were carrying scrim they never needed. Re-run the script
	 * when a hero is replaced.
	 */
	veil?: number;
}

const {
	image,
	mobileImage,
	alt,
	eyebrow,
	title,
	lede,
	size = 'page',
	priority = false,
	position = 'center 45%',
	mobilePosition = 'center',
	// Defaults to the old global value. A page that forgets to pass one is too
	// dark rather than illegible — the safe direction to fail in.
	veil = 68,
} = Astro.props;

// The block deepens slightly toward the bottom, as it always has. 6 points is
// what the original 70→80 ramp amounted to once the ramp itself was fixed.
const veilBottom = Math.min(100, veil + 6);

// Must stay in step with the `md` breakpoint used by the hero's own min-height
// below. If they drift, a phone gets the portrait crop in a landscape box (or the
// reverse) and the whole point of the art direction is lost.
const HERO_MEDIA = '(max-width: 767px)';

const DESKTOP_WIDTHS = [640, 960, 1280, 1600, 2000];
// The portrait master is 1440 wide. The most demanding real phone — a Pro Max at
// DPR 3 — needs 1290, so this tops out with headroom and never upscales.
const MOBILE_WIDTHS = [480, 720, 960, 1200, 1440];

const [desktopAvif, desktopWebp, mobileAvif, mobileWebp, fallback] = await Promise.all([
	getImage({ src: image, format: 'avif', widths: DESKTOP_WIDTHS, sizes: '100vw' }),
	getImage({ src: image, format: 'webp', widths: DESKTOP_WIDTHS, sizes: '100vw' }),
	mobileImage
		? getImage({ src: mobileImage, format: 'avif', widths: MOBILE_WIDTHS, sizes: '100vw' })
		: null,
	mobileImage
		? getImage({ src: mobileImage, format: 'webp', widths: MOBILE_WIDTHS, sizes: '100vw' })
		: null,
	getImage({ src: image, format: 'webp', width: 1280 }),
]);
---

{/*
	`id` is not decorative — BaseLayout's `<link rel="expect" blocking="render">`
	points at it to hold first paint until this section has been parsed. Renaming
	it silently turns that hold into "wait for the whole document".
*/}
<section
	id="hero"
	class:list={['hero', `hero--${size}`]}
	style={`--hero-pos: ${position}; --hero-pos-mobile: ${mobilePosition}; --hero-veil: ${veil}%; --hero-veil-bottom: ${veilBottom}%`}
	data-hero
>
	<div class="hero__media">
		{/*
			ART-DIRECTED, which is why this is a hand-written <picture> rather than
			<Picture>. Astro's component varies resolution and format; it cannot vary
			the ARTWORK by viewport, and resolution was never the problem here.

			The problem was `object-fit: cover` in a portrait box. On a phone the hero
			box is roughly 390x578 — taller than it is wide — while the landscape frame
			is 16:9. Cover scaled it to about 1000px wide to fill the height, so:

			  · ~62% of the photograph was cropped away, leaving a vertical slice
			  · `sizes="100vw"` honestly described the 390px LAYOUT box, so the browser
			    fetched a ~960w variant — then had to stretch it to ~2000 device px

			Both fixed by supplying a 2:3 crop composed for the box it actually lands
			in. Note `sizes="100vw"` is now accurate to within ~2% for the portrait
			source, because a matched aspect means cover scales by width, not height.

			Source order matters: first match wins, so the phone crop is tested before
			the unconditional landscape one, and AVIF precedes WebP within each.
		*/}
		<picture>
			{mobileAvif && (
				<source
					media={HERO_MEDIA}
					type="image/avif"
					srcset={mobileAvif.srcSet.attribute}
					sizes="100vw"
				/>
			)}
			{mobileWebp && (
				<source
					media={HERO_MEDIA}
					type="image/webp"
					srcset={mobileWebp.srcSet.attribute}
					sizes="100vw"
				/>
			)}
			<source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="100vw" />
			<source type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes="100vw" />
			{/*
				No width/height: the two crops have different aspect ratios, so one pair
				of intrinsic dimensions would describe the wrong shape at one breakpoint.
				`.hero` reserves the box with its own min-height and the image is
				absolutely sized into it, so there is no layout shift to guard against.
			*/}
			<img
				src={fallback.src}
				alt={alt}
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
				decoding="async"
			/>
		</picture>
		<div class="hero__wash" aria-hidden="true"></div>
		{/*
			The header sits over this band with no background of its own, so the nav
			has nothing but the photograph behind it. Measured across the five heroes,
			plaster nav text needs up to 65% to clear 4.5:1 against the brightest sky.
			At 72% the measured result was 4.52 — passing, but with 0.02 to spare, which
			is no margin at all for a photograph we intend to replace. 80% buys real
			headroom and is still invisible as a band.
		*/}
		<div class="hero__header-scrim" aria-hidden="true"></div>
	</div>

	<div class="hero__veil pp-on-dark">
		<Container class="hero__inner">
			{eyebrow && <p class="pp-eyebrow hero__eyebrow">{eyebrow}</p>}
			<h1 class="hero__title">{title}</h1>
			{/*
				`lede` stays a plain string and stays ESCAPED. A `lede` slot is the way
				to get markup — a line break, an <em> — into it.

				Deliberately not `set:html={lede}`, which would have been the one-line
				version. That turns every lede on the site into an HTML context for the
				sake of one page's line break, and `tenants.astro`'s lede already reads
				"wellness, & studios" — a bare ampersand that is fine as text and
				invalid as markup. Browsers forgive it; the next one might not be
				forgivable. The slot keeps the default safe and makes the exception
				explicit at the call site.
			*/}
			{
				Astro.slots.has('lede') ? (
					<p class="hero__lede">
						<slot name="lede" />
					</p>
				) : (
					lede && <p class="hero__lede">{lede}</p>
				)
			}
			{
				Astro.slots.has('actions') && (
					<div class="hero__actions">
						<slot name="actions" />
					</div>
				)
			}
		</Container>
	</div>
</section>

<style lang="scss">
	.hero {
		position: relative;
		display: grid;
		align-items: end;
		overflow: hidden;
		isolation: isolate;

		// Pull up under the overlaying header, then pad back down by the same
		// amount so nothing composes into the header band.
		margin-block-start: calc(-1 * var(--pp-header-h));
		padding-block-start: var(--pp-header-h);
	}

	// One height for every page. Inner heroes were 488px against Home's 674px,
	// which left as little as 83px of photograph visible above the text block on
	// Spaces — paying for the vertical space without reading as a photograph.
	//
	// `size` now controls typography only, not height.
	//
	// Not 100dvh: a full-height hero on the ThinkPad E14's short desktop viewport
	// pushes every piece of qualifying information below the fold, which is the
	// wrong trade on a leasing site — hence the short-viewport cap.
	// 60svh on phones, 74svh from `md`.
	//
	// The same argument the short-viewport cap above is built on, applied to the
	// device where it bites hardest. At 74svh the hero occupied 76–83% of a phone
	// screen, so every piece of qualifying information — the use-type grid, the
	// stat strip — sat below the fold. 60svh brings it to ~69%: still full-bleed
	// and immersive, but the next section now signals itself.
	//
	// ⚠️ The breakpoint here and `HERO_MEDIA` in the frontmatter are one decision
	// in two places. 60svh is what makes the phone box ~2:3, which is the aspect
	// the portrait crops were cut to. Move one without the other and the crops
	// stop matching their box.
	.hero {
		min-height: calc(min(60svh, 40rem) + var(--pp-header-h));

		@include from('md') {
			min-height: calc(min(74svh, 40rem) + var(--pp-header-h));
		}

		// Last, so it wins over the `md` rule it overlaps with.
		@include short-viewport {
			min-height: 30rem;
		}
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;

		// <picture> wraps the <img>; `display: contents` keeps that wrapper out of
		// layout so the image still fills the media box directly.
		:global(picture) {
			display: contents;
		}

		// `object-position` cannot vary per <source>, so it comes through custom
		// properties set on the section and swapped at the breakpoint. It used to be
		// an inline `style` on the img, which no stylesheet rule could have
		// overridden — inline always wins.
		//
		// The portrait crops are composed for their box, so they default to centre;
		// the landscape frame keeps its per-page focal point.
		:global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: var(--hero-pos-mobile);

			@include from('md') {
				object-position: var(--hero-pos);
			}
		}
	}

	// Layer 1 — a light wash over the whole photograph. Enough to settle it into
	// the palette; nowhere near enough to carry text on its own.
	// 0 → 8%, down from 10 → 22%.
	//
	// This is the layer the "too dark" note was actually about. The veil sits
	// behind text, where darkness is load-bearing; the wash covers the WHOLE
	// photograph, so it is the only layer muting the part of the picture anyone is
	// looking at. Measured across all ten heroes, the brightest 5% of each text
	// zone needs between 44% and 63% espresso for plaster text at 4.5:1 — the wash
	// contributes almost nothing to that, so cutting it costs no contrast and
	// hands back most of the photograph.
	.hero__wash {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--pp-espresso) 0%, transparent) 0%,
			color-mix(in srgb, var(--pp-espresso) 8%, transparent) 100%
		);
	}

	// The header band. Steep and short: fully out by 190px, so it protects the nav
	// without re-darkening the picture the way a full-image gradient did.
	.hero__header-scrim {
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		height: 190px;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--pp-espresso) 80%, transparent) 0%,
			color-mix(in srgb, var(--pp-espresso) 55%, transparent) 45%,
			color-mix(in srgb, var(--pp-espresso) 0%, transparent) 100%
		);
	}

	// Layer 2 — the veil that actually carries the text. It wraps the copy, so it
	// is exactly as tall as the copy plus its padding, and the gradient's fade
	// happens within that top padding.
	// .pp-on-dark is on this element in the markup: it is a dark surface, and
	// without it a `secondary` button keeps its light-context espresso fill and
	// vanishes into the scrim — a ghost button in all but name.
	//
	// The `background` shorthand below resets background-color, so .pp-on-dark's
	// espresso fill is discarded and the gradient becomes the surface.
	// THE RAMP NOW ENDS AT THE PADDING, IN THE SAME UNIT AS THE PADDING.
	//
	// It used to reach full strength at `38%` — a percentage of the veil's own
	// height, which is set by how much text the page happens to carry. The comment
	// here claimed the fade therefore "happens inside the top padding, so text
	// always sits in the fully-opaque part". That was never true. For 38% to land
	// inside a 96px padding the whole veil would have to be under 253px, and the
	// smallest possible veil on this site — one line of h1, a two-line lede, no
	// CTA — is already 270px. Every real page is taller still.
	//
	// So the first line of text sat ON the ramp, at roughly 51–57% composite.
	// History's phone crop needs 58%, which means its eyebrow was failing 4.5:1.
	//
	// Driving both the padding and the colour stop from one custom property makes
	// the guarantee structural: the veil is at full strength exactly where the text
	// begins, at any text length, on any page, forever. `--hero-veil-pad` is the
	// single knob — change it and the ramp follows.
	.hero__veil {
		--hero-veil-pad: var(--pp-space-2xl);

		position: relative;
		padding-block: var(--hero-veil-pad) var(--pp-space-l);
		// 68% / 74%, down from 70% / 80%. Ending the ramp early adds protection at
		// the top, which buys the headroom to lighten the heaviest band at the
		// bottom — so the text is better covered than before AND the block reads
		// lighter. Worst hero of the ten needs 63%; this holds ≥70% throughout.
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--pp-espresso) 0%, transparent) 0,
			color-mix(in srgb, var(--pp-espresso) var(--hero-veil), transparent) var(--hero-veil-pad),
			color-mix(in srgb, var(--pp-espresso) var(--hero-veil-bottom), transparent) 100%
		);
	}

	.hero--display .hero__veil {
		--hero-veil-pad: var(--pp-space-3xl);

		padding-block: var(--hero-veil-pad) var(--pp-space-2xl);
	}

	// Plaster, not limestone: at the worst-case scrim/photo blend plaster reaches
	// 4.73:1 and limestone only 3.71:1. Plaster is warm enough not to read as
	// harsh white.
	.hero__eyebrow {
		color: var(--pp-plaster);
		margin-block-end: var(--pp-space-xs);
	}

	.hero__title {
		color: #fff;
		line-height: var(--pp-leading-tight);
		letter-spacing: var(--pp-tracking-tight);
		text-wrap: balance;
	}

	.hero--display .hero__title {
		font-size: var(--pp-text-display);
		max-width: 16ch;
	}

	.hero--page .hero__title {
		font-size: var(--pp-text-h1);
		max-width: 20ch;
	}

	.hero__lede {
		margin-block-start: var(--pp-space-m);
		max-width: 46ch;
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		// 20–23px regular is NOT "large text" under WCAG (that needs 24px), so this
		// carries the full 4.5:1 requirement like body copy.
		color: var(--pp-plaster);
		text-wrap: pretty;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
		margin-block-start: var(--pp-space-l);
	}
</style>
