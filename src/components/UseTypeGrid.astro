---
import { Icon } from 'astro-icon/components';
import { USE_TYPES } from '../config/site';

/**
 * Icon + label grid.
 *
 * Takes `items` so the Spaces page's "kinds of space" list can be the same
 * object as the Home page's "who this suits" list rather than a lookalike.
 * They were drifting apart — one was numerals in a different grid — and two
 * near-identical treatments of the same idea is what made the site read as
 * inconsistent. Defaults to USE_TYPES so Home needs no props.
 */
interface Props {
	items?: readonly { icon: string; label: string }[];
}

const { items = USE_TYPES } = Astro.props;
---

<ul class="uses" role="list">
	{
		items.map((use) => (
			<li class="use">
				{/*
					Icons are decorative — the label carries the meaning, so aria-hidden
					stops a screen reader announcing "store, Retail and business".
				*/}
				<Icon name={use.icon} class="use__icon" aria-hidden="true" />
				<span class="use__label">{use.label}</span>
			</li>
		))
	}
</ul>

<style lang="scss">
	.uses {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--pp-space-xs);
		margin: 0;
		padding: 0;

		// Caps at 3, not 4. Both lists that use this component are six items, and at
		// four across that lands as a row of four over a row of two — the orphan row
		// reads as something missing rather than as a deliberate shape. Six over
		// three is two even rows; six over two (mobile) is three even rows. The 4-up
		// rule was written when these lists were eight.
		//
		// If a list ever grows past six, revisit: at seven or eight, 4-up is the
		// better fit again and this cap becomes the thing making an orphan row.
		@include from('sm') {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.use {
		display: flex;
		align-items: center;
		gap: var(--pp-space-2xs);
		padding: var(--pp-space-s);
		background-color: var(--pp-raised);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);

		// Not interactive — no href, no handler — so it gets no hover lift and no
		// pointer cursor. Affording a click that doesn't exist is worse than being
		// plain.
	}

	.use__icon {
		flex: none;
		width: 20px;
		height: 20px;
		color: var(--pp-bronze); // decorative, non-text — 3.48:1 clears the UI threshold
	}

	.use__label {
		font-size: var(--pp-text-s);
		font-weight: var(--pp-weight-medium);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink);
		text-wrap: balance;
	}
</style>
