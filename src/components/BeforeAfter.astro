---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A then/now pair, shown side by side.
 *
 * Deliberately NOT a drag-slider or a hover crossfade. The two frames are shot
 * from the same position, so showing both at once lets the eye compare directly —
 * a slider forces sequential viewing, hides half the content at any moment, is
 * fiddly on touch, and needs bespoke keyboard handling to be operable at all.
 * The alignment is doing the work here; an interaction would get in its way.
 */
interface Props {
	then: ImageMetadata;
	now: ImageMetadata;
	thenAlt: string;
	nowAlt: string;
	thenCaption?: string;
	nowCaption?: string;
	/** Layout hint — `stacked` forces one column even on wide screens. */
	layout?: 'side-by-side' | 'stacked';
	/** First pair on the page gets eager loading; the rest stay lazy. */
	priority?: boolean;
	sizes?: string;
	class?: string;
}

const {
	then,
	now,
	thenAlt,
	nowAlt,
	thenCaption,
	nowCaption,
	layout = 'side-by-side',
	priority = false,
	sizes = '(min-width: 768px) 45vw, 92vw',
	class: className,
} = Astro.props;
---

{/*
	One <figure> per frame, nested inside the pair's own <figure> — the same
	construction MilestoneFigures uses, and the reason its captions have always
	stacked correctly.

	This used to be a single <figcaption> holding two <span>s, laid out as a
	two-column grid. That works on desktop only by coincidence: the frames are a
	two-column grid and the caption is a matching two-column grid, so the columns
	happen to line up. Collapse both to one column on mobile and the DOM order is
	what you actually get — image, image, caption, caption — with both captions
	orphaned under the second photograph.

	Putting each caption inside its own figure makes the pairing structural
	instead of coincidental, so it survives any layout the grid is put into, and
	it ties each caption to its image for assistive tech rather than leaving one
	caption to describe two images.
*/}
<figure class:list={['ba', `ba--${layout}`, className]}>
	<div class="ba__frames">
		<figure class="ba__item">
			<div class="ba__frame">
				<Image
					src={then}
					alt={thenAlt}
					sizes={sizes}
					widths={[440, 700, 880]}
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : 'auto'}
				/>
				<span class="ba__tag ba__tag--then">Then</span>
			</div>
			{thenCaption && <figcaption class="ba__label">{thenCaption}</figcaption>}
		</figure>

		<figure class="ba__item">
			<div class="ba__frame">
				<Image
					src={now}
					alt={nowAlt}
					sizes={sizes}
					widths={[440, 700, 880]}
					loading={priority ? 'eager' : 'lazy'}
					fetchpriority={priority ? 'high' : 'auto'}
				/>
				<span class="ba__tag ba__tag--now">Now</span>
			</div>
			{nowCaption && <figcaption class="ba__label">{nowCaption}</figcaption>}
		</figure>
	</div>
</figure>

<style lang="scss">
	.ba {
		margin: 0;
	}

	// Rows and columns need different gaps now. A row gap separates one complete
	// image-plus-caption unit from the next, which wants more air than the column
	// gap between two frames sitting shoulder to shoulder. Side-by-side on desktop
	// is a single row, so only the column value applies there and that layout is
	// unchanged.
	.ba__frames {
		display: grid;
		row-gap: var(--pp-space-s);
		column-gap: var(--pp-space-xs);

		.ba--side-by-side & {
			@include from('md') {
				grid-template-columns: 1fr 1fr;
			}
		}
	}

	// Nested <figure>, so it carries a UA margin that has to go.
	.ba__item {
		display: flex;
		flex-direction: column;
		margin: 0;
	}

	.ba__frame {
		position: relative;
		overflow: hidden;
		border-radius: var(--pp-radius-m);
		background-color: var(--pp-limestone);

		:global(img) {
			display: block;
			width: 100%;
			height: auto;
			// Both frames are 875×512, so no aspect-ratio juggling is needed — but
			// the explicit ratio guards against a replacement image of a different
			// shape silently reintroducing layout shift.
			aspect-ratio: 875 / 512;
			object-fit: cover;
		}
	}

	// Labels are part of the content, not decoration: without them the pair is
	// ambiguous, and "then" is not always obviously the older photograph once the
	// tinting is subtle.
	.ba__tag {
		@include eyebrow;

		position: absolute;
		inset-block-start: var(--pp-space-2xs);
		inset-inline-start: var(--pp-space-2xs);
		padding: 0.35em 0.7em;
		border-radius: var(--pp-radius-s);
		font-size: var(--pp-text-2xs);
	}

	.ba__tag--then {
		color: var(--pp-limestone);
		background-color: color-mix(in srgb, var(--pp-espresso) 88%, transparent);
	}

	.ba__tag--now {
		color: var(--pp-espresso);
		background-color: color-mix(in srgb, var(--pp-plaster) 92%, transparent);
	}

	// `margin-block-start: auto` pins the caption to the bottom of a stretched
	// grid row, so the two captions share a baseline even if the frames ever end
	// up different heights; the padding is what actually creates the gap under the
	// image. Same construction as MilestoneFigures' `.fig__caption`.
	//
	// Today the frames are locked to one aspect-ratio so their heights already
	// match — this is the guard for the day a replacement image isn't 875×512.
	.ba__label {
		margin-block-start: auto;
		padding-block-start: var(--pp-space-xs);
		font-size: var(--pp-text-xs);
		line-height: var(--pp-leading-normal);
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}
</style>
