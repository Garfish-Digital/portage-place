---
// Fontsource stylesheets. `standard` carries the opsz + wght axes; the italic
// faces declare their own unicode-range so the browser only fetches them when
// italic text actually renders.
//
// `standard` carries the opsz + wght axes for Fraunces (65.7 KB latin); the
// italic faces declare their own unicode-range so the browser only fetches them
// when italic text actually renders.
//
// Deliberately NOT `full.css` — that adds the SOFT and WONK axes at +53 KB, and
// the wonky single-story `g` and swashes read as artisanal-coffee-brand rather
// than restored-landmark.
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource-variable/public-sans/wght-italic.css';

// Preload only the two faces needed for first paint. Preloading all four would
// make the italics compete with the LCP element for bandwidth.
import displayFontUrl from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import publicSansUrl from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

import '../styles/global.scss';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// import FloatingCta from '../components/FloatingCta.astro';
// ⚠️ EMAIL CAPTURE REMOVED 2026-08-30, per the client. Every CTA on the site now
// links to /contact, where the address and phone are published as mailto:/tel:
// links instead. Commented rather than deleted, matching FloatingCta above — the
// component, its Netlify Forms wiring and its success panel are all intact in
// `src/components/ContactModal.astro` if this is reversed.
//
// Nothing carries `data-open-contact` any more, so the modal has no opener even
// if it is rendered. Restoring means uncommenting here AND putting a trigger back.
// import ContactModal from '../components/ContactModal.astro';

interface Props {
	title: string;
	description: string;
	/** Keep out of search results — scaffolding and internal pages. */
	noindex?: boolean;
	/**
	 * Path to an OG image in /public. Defaults to the lockup card so every page
	 * shares to a real preview; pass a per-page image when Phase 7's hand-made
	 * set lands.
	 */
	ogImage?: string;
	/**
	 * Element id to hold first paint for. Defaults to the hero, which every real
	 * page has; pass `null` on pages without one (see the head for why).
	 */
	renderHold?: string | null;
}

const {
	title,
	description,
	noindex = false,
	ogImage = '/ogImage.png',
	renderHold = 'hero',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = ogImage ? new URL(ogImage, canonical) : undefined;
const fullTitle = title === 'Portage Place' ? title : `${title} — Portage Place`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		{/*
			Preload before the stylesheet link so the font request starts in the same
			round trip as the CSS rather than after it. crossorigin is required even
			same-origin: without it the preload is fetched a second time.
		*/}
		<link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={publicSansUrl} as="font" type="font/woff2" crossorigin />

		{/*
			Hold first paint until the hero has been parsed.

			Cross-document view transitions snapshot the incoming page at its first
			render opportunity. Without this the browser can reach that moment before
			the hero exists, so the fade lands on a page whose main element is not
			there yet and the hero drops in afterwards.

			What it does NOT do is wait for the photograph to download or decode —
			images are not render-blocking, and nothing short of stalling the
			navigation would make that guarantee. This buys the image the parse time
			as a head start; it does not remove the possibility of a late paint on a
			cold cache.

			⚠️ If the id is absent, rendering is held until the document finishes
			parsing instead. That is harmless on these pages but wasteful on a long
			one, which is why `specimen` and `deploy-check` pass `renderHold={null}`.
		*/}
		{renderHold && <link rel="expect" href={`#${renderHold}`} blocking="render" />}

		{/*
			Generated by `node scripts/make-icons.mjs` — committed, not built.
			SVG first for browsers that take it; .ico is the fallback and carries
			16/32/48 so Windows and feed readers pick their own.
			Both use icon-heavy: the lockup's rules are 0.09px at 16px.
		*/}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		{/*
			iOS ignores the manifest for home-screen icons and reads this instead.
			The file is opaque with square corners on purpose — iOS applies its own
			mask, and a pre-rounded icon gets rounded twice.
		*/}
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#322f2c" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Portage Place" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		{/*
			Dimensions let a platform reserve the card's space before the image
			arrives; alt is read out by screen readers on Mastodon, LinkedIn and X.
		*/}
		{ogImageUrl && (
			<>
				<meta property="og:image" content={ogImageUrl.href} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
				<meta property="og:image:alt" content="Portage Place — the interlocking PP mark above the wordmark, white on black." />
			</>
		)}
		{/*
			No `twitter:site` or `twitter:creator`: the client has Instagram only, and
			an invented or empty handle is worse than an absent one. X reads og:image
			and og:title directly, so the card works without them. One line to add if
			an account ever exists.
		*/}
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

		<slot name="head" />
	</head>

	<body>
		<a class="pp-skip-link" href="#main">Skip to content</a>

		<Header />

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<Footer />

		{/* <FloatingCta /> */}
		{/* <ContactModal /> */}
	</body>
</html>

<style lang="scss">
	// tabindex="-1" makes <main> a valid skip-link target, but Safari and Chrome
	// both paint a focus ring on it when it receives programmatic focus. The
	// landmark isn't an interactive control, so the ring is noise.
	main:focus {
		outline: none;
	}
</style>
