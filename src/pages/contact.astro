---
import { getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { CONTACT, MAP_EMBED_URL } from '../config/nav';

// Static map over Thunderforest/OSM tiles.
//
// ART DIRECTION, not just resizing. Two separate crops, because scaling one
// image down does not survive the trip to a phone: the desktop artwork is 2300px
// wide shown in roughly 350 CSS px, a 0.15x reduction that turns every street
// label into about four pixels of noise. The mobile crop is zoomed in far enough
// that its labels stay readable at the size they are actually displayed.
//
// That needs `<picture>` with `media`, which `<Image>`/`<Picture>` can't express
// — they vary resolution and format, not artwork. Hence `getImage()` and a
// hand-written <picture>: the browser then downloads exactly one of the two, so
// a phone never pays for the 2 MB desktop crop.
//
// Attribution is NOT baked into these files. It is rendered as a caption below
// the map, which satisfies ODbL and Thunderforest just as well and keeps the
// credit in the site's own type instead of the tile renderer's.
import desktopMap from '../assets/maps/desktop-location.png';
import mobileMap from '../assets/maps/mobile-location.png';
import { ACCESS } from '../config/site';

const { street, city, region, postalCode } = CONTACT.address;

// Google Maps directions deep-link. Sends the visitor to their own map app with
// the destination pre-filled rather than embedding a 1 MB third-party iframe that
// sets cookies before they've done anything.
const mapQuery = encodeURIComponent(`Portage Place, ${street}, ${city}, ${region} ${postalCode}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

// 768px is `md` in $breakpoints, and it has to stay in step with the aspect-ratio
// switch in the style block below. If they drift, the container's shape and the
// artwork's shape disagree and one of the two crops gets cut.
const MAP_MEDIA = '(min-width: 768px)';

// `widths` stop at each source's own width — beyond that Astro upscales, which
// costs bytes and adds nothing. AVIF first, WebP second: these are flat-colour
// vector renders, exactly the content AVIF handles best.
const [desktopAvif, desktopWebp, mobileAvif, mobileWebp, mapFallback] = await Promise.all([
	getImage({ src: desktopMap, format: 'avif', widths: [768, 1240, 1860, 2300], sizes: '70vw' }),
	getImage({ src: desktopMap, format: 'webp', widths: [768, 1240, 1860, 2300], sizes: '70vw' }),
	getImage({ src: mobileMap, format: 'avif', widths: [360, 720, 1006], sizes: '94vw' }),
	getImage({ src: mobileMap, format: 'webp', widths: [360, 720, 1006], sizes: '94vw' }),
	getImage({ src: desktopMap, format: 'webp', width: 1240 }),
]);

const mapAlt =
	'Street map of the Near Northwest Neighborhood with Portage Place marked on Portage Avenue, between California Avenue and the St. Joseph River.';

// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/contact.jpg';
import heroImageMobile from '../assets/heroes/contact-mobile.jpg';
---

<BaseLayout
	title="Contact"
	description="Visit or email Portage Place — 908 Portage Avenue, South Bend, Indiana. Commercial and office space from 200 to 1,800 sq ft."
>
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		veil={54}
		alt="The building entrance from inside: glazed double doors and a tall window wall throwing afternoon light across the concrete floor."
		eyebrow="Reach out"
		title="Tell us about the space you need"
		lede="Simply send an email."
		position="center 45%"
		priority
	>
		<Fragment slot="actions">
			<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Email us</Button>
		</Fragment>
	</PageHero>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone">
		<div class="details">
			<div class="detail">
				<h2 class="detail__label">Address</h2>
				<address class="detail__body">
					Portage Place<br />
					{street}<br />
					{city}, {region} {postalCode}
				</address>
			</div>

			<div class="detail">
				<h2 class="detail__label">Getting here</h2>
				<ul class="access" role="list">
					{
						ACCESS.map((item) => (
							<li class="access__item">
								<Icon name="lucide:check" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="detail">
				<h2 class="detail__label">Interactive map</h2>
				{/*
					A <button>, not a link: it loads the map into the page below rather
					than navigating away. `aria-controls` ties it to the region it changes,
					and the script moves focus there so a keyboard user isn't left behind.
				*/}
				<Button
					type="button"
					icon="lucide:navigation"
					aria-controls="map-region"
					data-load-map
				>
					Show map
				</Button>
				<p class="detail__hint">Click to load Google Maps</p>
			</div>
		</div>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* ------------------------------------------------------------------ */}
	<Section>
		{/*
			Two-line block-head, matching the Suites floor plan — the closest analogue
			on the site: a section whose whole content is one static artefact that
			becomes interactive on demand. No lede, because `.map__escape` below the
			map already carries the explanatory sentence.

			It also gives the map region a heading of its own. Before this the only
			heading naming the map was "Interactive map" two sections up, attached to
			the button rather than to the map, so anyone navigating by heading landed
			on a control and found the map itself unannounced.
		*/}
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Find us</p>
			<h2>In the Near Northwest Neighborhood of South Bend</h2>
		</div>

		<div class="map" id="map-region" tabindex="-1" data-map-region>
			{/*
				Facade. The styled static map (Phase 4) sits here until clicked; only
				then does the Google iframe load. Google sets third-party cookies and
				pulls a large payload the instant it loads, so doing that to every
				visitor who opens Contact is what this pattern avoids.
			*/}
			<div class="map__facade" data-map-facade>
				{/*
					Source order matters: the browser takes the FIRST matching <source>,
					so the desktop crop has to be tested before the unconditional mobile
					one. Within each crop, AVIF precedes WebP for the same reason.

					No `width`/`height` on the <img>, deliberately. The two crops have
					DIFFERENT ratios (1.49 mobile, 1.70 desktop), so a single pair of
					intrinsic dimensions would describe the wrong shape at one breakpoint
					and let the browser infer an aspect ratio that never renders. Nothing
					is lost: `.map` reserves the box with its own aspect-ratio and
					`.map__static` fills it, so there is no layout shift to protect
					against. It also keeps Astro from emitting the untouched 2 MB PNG
					alongside the optimised variants.
				*/}
				<picture>
					<source media={MAP_MEDIA} type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="70vw" />
					<source media={MAP_MEDIA} type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes="70vw" />
					<source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="94vw" />
					<source type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="94vw" />
					<img
						src={mapFallback.src}
						alt={mapAlt}
						class="map__static"
						loading="lazy"
						decoding="async"
					/>
				</picture>
				<div class="map__control">
					<Button variant="quiet" type="button" icon="lucide:map" data-load-map>
						Load Google Maps
					</Button>
				</div>
			</div>
		</div>

		{/*
			Required credit, not decoration. OSM's ODbL obliges attribution on a
			produced work and Thunderforest requires their own; a caption adjacent to
			the map satisfies both, and unlike the baked-in version it stays in Public
			Sans and survives the eventual hand-drawn replacement.
		*/}
		<p class="map__credit">Maps &copy; Thunderforest, Data &copy; OpenStreetMap contributors</p>

		<p class="map__escape">
			Or <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
				open it in Google Maps
				<Icon name="lucide:arrow-up-right" aria-hidden="true" />
				<span class="pp-visually-hidden">(opens in a new tab)</span></a> — better if
			you're heading here now and want it on your phone.
		</p>
	</Section>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">Still deciding?</p>
				<h2 class="cta__title">Have a look at what's here</h2>
				<p class="cta__lede">
					Sizes, wings and what fits where — plus the hundred-year story behind the
					building.
				</p>
			</div>
			<div class="cta__actions">
				<Button variant="quiet" size="lg" href="/spaces">Find your space</Button>
				<Button variant="quiet" size="lg" href="/history">The history</Button>
			</div>
		</div>
	</Section>
</BaseLayout>

<script>
	import { MAP_EMBED_URL } from '../config/nav';

	// Click-to-load map. The only JS on this page, and it exists to keep Google's
	// cookies and payload off visitors who never ask for the map.
	const region = document.querySelector<HTMLElement>('[data-map-region]');
	const facade = document.querySelector<HTMLElement>('[data-map-facade]');
	const triggers = document.querySelectorAll<HTMLButtonElement>('[data-load-map]');

	if (region && facade && triggers.length) {
		let loaded = false;

		const load = () => {
			if (loaded) return;
			loaded = true;

			const frame = document.createElement('iframe');
			frame.src = MAP_EMBED_URL;
			// Without a title the frame is announced as an unlabeled region.
			frame.title = 'Google Maps showing Portage Place, 908 Portage Avenue, South Bend, Indiana';
			frame.loading = 'lazy';
			frame.referrerPolicy = 'no-referrer-when-downgrade';
			frame.className = 'map__frame';
			frame.setAttribute('allowfullscreen', '');

			facade.replaceWith(frame);

			// The control that was clicked may now be off-screen, and the thing it
			// changed is elsewhere on the page. Move focus to the region so a
			// keyboard or screen-reader user lands on what they just asked for.
			region.focus();

			triggers.forEach((button) => {
				button.disabled = true;
				button.textContent = 'Map loaded';
			});
		};

		triggers.forEach((button) => button.addEventListener('click', load));
	}
</script>

<style lang="scss">
	.intro {
		max-width: 44rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.intro__actions {
		margin-block-start: var(--pp-space-l);
	}

	// ---------------------------------------------------------------------------
	.details {
		display: grid;
		gap: var(--pp-space-xl);

		@include from('md') {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--pp-space-2xl);
		}
	}

	.detail__label {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-s);
	}

	.detail__body {
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-h4);
		font-style: normal;
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-strong);
	}

	.detail__body--pending {
		font-family: var(--pp-font-body);
		font-size: var(--pp-text-s);
		color: var(--pp-error);
		font-style: italic;
	}

	.detail__actions {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--pp-space-s);
		margin-block-start: var(--pp-space-m);
	}

	.detail__link {
		display: inline-flex;
		align-items: center;
		gap: 0.25em;
		font-size: var(--pp-text-s);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-green-link);
		text-decoration: none;

		@include focusable;

		:global(svg) {
			width: 14px;
			height: 14px;
		}
	}

	.access {
		display: grid;
		gap: var(--pp-space-2xs);
		margin: 0;
		padding: 0;
	}

	.access__item {
		display: flex;
		align-items: center;
		gap: var(--pp-space-2xs);
		font-size: var(--pp-text-s);
		color: var(--pp-ink);

		:global(svg) {
			flex: none;
			width: 16px;
			height: 16px;
			color: var(--pp-green);
		}
	}

	// ---------------------------------------------------------------------------
	// Map
	// ---------------------------------------------------------------------------
	// `.block-head` is NOT global — Home, Suites and Community each carry their own
	// copy in their own scoped style block, so a page using the markup without the
	// rules gets a completely unstyled heading. That is what happened here: with no
	// `margin-block-end` the h2 sat directly on the map and the descender of the
	// "g" in Neighborhood crossed into the image.
	//
	// Matching the other three exactly rather than inventing a local variant. See
	// the note in BUILD_PLAN about consolidating these four copies.
	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.map {
		// Reserved before anything loads, so swapping the facade for the iframe
		// costs no layout shift.
		//
		// The height is capped by the ASPECT RATIO, never by max-block-size. Pairing
		// `aspect-ratio` with `max-block-size: 30rem` made the box resolve to a fixed
		// 853px width (480 x 16/9) which then sat left-aligned inside a 1120px
		// container — reading as broken alignment on every viewport above ~935px,
		// and self-correcting below it only because the container got narrower.
		// Widening the ratio on large screens caps the height without ever
		// under-filling the column.
		width: 100%;
		// One ratio per crop, each matching its own artwork exactly, so NEITHER view
		// is cropped and object-position never has to rescue anything. The
		// breakpoint here must stay in step with MAP_MEDIA in the frontmatter.
		//
		// mobile-location.png is 1006 x 674; desktop-location.png is 2300 x 1354,
		// which is the same 1.699 ratio as the 1240 x 730 this was written against.
		aspect-ratio: 1006 / 674;
		overflow: hidden;

		@include from('md') {
			aspect-ratio: 2300 / 1354;
		}
		border-radius: var(--pp-radius-m);
		background-color: var(--pp-limestone);

		// tabindex="-1" makes it a focus target; the ring would otherwise be noise
		// on a non-interactive region.
		&:focus {
			outline: none;
		}
	}

	.map__facade {
		position: relative;
		height: 100%;
		border-radius: inherit;
		overflow: hidden;
	}

	:global(.map__static) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		// The pin is centred in both crops now, so a centred crop is the safe one —
		// this used to be `20% 30%`, tuned for older artwork whose marker sat high
		// and left. With each container ratio matched to its own artwork there is
		// nothing to crop at either size; this only governs the in-between states
		// (a ratio the media query hasn't caught up with, or a future re-crop), and
		// centring keeps the marker the last thing lost rather than the first.
		object-position: center;
	}

	// The trigger sits on a solid chip rather than floating on the map: a
	// translucent control over cartography can't have a predictable contrast ratio,
	// because the pixels behind it change with the crop.
	.map__control {
		position: absolute;
		inset-block-end: var(--pp-space-s);
		inset-inline-end: var(--pp-space-s);
		padding: var(--pp-space-3xs);
		background-color: var(--pp-plaster);
		border-radius: var(--pp-radius-m);
		box-shadow: var(--pp-shadow-m);
	}

	:global(.map__frame) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	// Kept even once the embed loads. Google's iframe is patchy for keyboard users,
	// and anyone actually traveling here wants the destination on their phone.
	// Right-aligned under the map, where a baked-in tile credit would have sat —
	// familiar position, but in Public Sans at the smallest step and in muted ink,
	// so it satisfies the licence without competing with the escape link beneath
	// it. `xs` on `--pp-ink-muted` is 6.84:1, comfortably past 4.5:1.
	.map__credit {
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
		text-align: end;
	}

	.map__escape {
		margin-block-start: var(--pp-space-s);
		font-size: var(--pp-text-s);
		color: var(--pp-ink-muted);

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.2em;
			color: var(--pp-green-link);
			font-weight: var(--pp-weight-semibold);

			:global(svg) {
				width: 13px;
				height: 13px;
			}
		}
	}

	.detail__hint {
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	// ---------------------------------------------------------------------------
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	// brick-dark, not bronze: bronze is 3.48:1 on plaster and 2.65:1 on limestone,
	// both failures for text. Bronze stays non-text only — rules, rings, markers.
	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>
