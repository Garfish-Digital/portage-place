---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { CONTACT, MAP_EMBED_URL } from '../config/nav';


// The Near Northwest Neighborhood building at 1005 Portage Avenue, and the
// people of the corridor. Paired with the "Find us" heading rather than dropped
// in decoratively: the parapet in the photograph spells the neighbourhood the
// heading names, which is a rare case of an image proving its own caption.
import localeImage from '../assets/contact/neighborhood.webp';
import { ACCESS } from '../config/site';

const { street, city, region, postalCode } = CONTACT.address;


// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/contact.jpg';
import heroImageMobile from '../assets/heroes/contact-mobile.jpg';
---

<BaseLayout
	title="Contact"
	description="Visit or email Portage Place — 908 Portage Avenue, South Bend, Indiana. Commercial and office space from 200 to 1,800 sq ft."
>
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		veil={54}
		alt="The building entrance from inside: glazed double doors and a tall window wall throwing afternoon light across the concrete floor."
		eyebrow="Reach out"
		title="Tell us about the space you need"
		lede="Simply send an email."
		position="center 45%"
		priority
	>
	</PageHero>

	{/* ------------------------------------------------------------------ */}
	{/* Plaster, per the client 2026-08-25. Restore with `tone="limestone"`. */}
	<Section>
	{/*
		Two columns, per the client 2026-08-30: contact details left, location right.
		Was three (Address · Getting here · Interactive map) plus the standalone
		Email and Phone blocks added earlier the same day, which split four related
		facts across four columns and left the phone and email looking stranded.

		The type scale inverts what was here before, deliberately. Phone and email
		are now the largest thing in the section and the street address is set at
		the same size as the access list, because with no form on the site those two
		links ARE the conversion path and the address is reference material.
	*/}
	<div class="details">
		<div class="detail">
			<h2 class="detail__label">Contact Information</h2>

			<p class="detail__contact">
				<a class="detail__link" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
			</p>
			<p class="detail__contact">
				<a class="detail__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
			</p>

			{/* Client-supplied 2026-08-30. Same treatment as the address below it. */}
			<p class="detail__agent">Mike Keen, Leasing Agent</p>

			
		</div>

		<div class="detail">
			<h2 class="detail__label">Location</h2>

            <address class="detail__address">
				Portage Place<br />
				{street}<br />
				{city}, {region} {postalCode}
			</address>
			<!-- <ul class="access" role="list">
				{
					ACCESS.map((item) => (
						<li class="access__item">
							<Icon name="lucide:check" aria-hidden="true" />
							<span>{item}</span>
						</li>
					))
				}
			</ul> -->

			{/*
				An in-page anchor, not a link out. It jumps to the embedded map below
				rather than handing off to Google Maps — the client's call 2026-08-30.

				`#map-region` is a plain fragment link, so the scroll is native and
				`_reset.scss` already disables the smooth behaviour under
				prefers-reduced-motion. The target carries `tabindex="-1"` so focus
				follows the jump instead of staying behind on the button, which is what
				a keyboard or screen-reader user needs when the thing they asked for is
				a non-interactive region.
			*/}
			<div class="detail__action">
				<Button variant="quiet" href="#map-region" icon="lucide:navigation" data-scroll-to-map>
					Get directions
				</Button>
			</div>
		</div>
	</div>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* ------------------------------------------------------------------ */}
	<Section>
		{/*
			Two-line block-head, matching the Suites floor plan — the closest analogue
			on the site: a section whose whole content is one static artefact that
			becomes interactive on demand. No lede: the map speaks for itself and the
			Get directions button above already carries the ask.

			It also gives the map region a heading of its own. Before this the only
			heading naming the map was "Interactive map" two sections up, attached to
			the button rather than to the map, so anyone navigating by heading landed
			on a control and found the map itself unannounced.
		*/}
		{/*
			Text beside one photograph — the Phase 2 layout from Suites, with a single
			frame instead of a pair. `.block-head`'s own bottom margin would fight the
			grid gap here, so the heading parts are used directly inside the text
			column rather than wrapped in it.
		*/}
		<div class="locale">
			<div class="locale__text">
				<p class="pp-eyebrow block-head__eyebrow">Find us</p>
				<h2>In the Near Northwest Neighborhood of South Bend</h2>
				<p class="block-head__lede">The Anchor for Portage Midtown</p>
			</div>

			<figure class="locale__media">
				{/*
					`widths` stops at the source's own 1600px — beyond that Astro upscales.
					At `lg` this renders about 528px wide, so 1600 covers a DPR2 display
					with room to spare. It is the full-bleed treatment the file could NOT
					have carried: 1120px across would have needed 2240.
				*/}
				<Image
					src={localeImage}
					alt="A large crowd gathered on the sidewalk outside the Near Northwest Neighborhood building on Portage Avenue, its name in gold lettering above a striped awning."
					widths={[560, 840, 1120, 1600]}
					sizes="(min-width: 1024px) 46vw, 92vw"
					loading="lazy"
				/>
			</figure>
		</div>

		{/*
			⚠️ FACADE REMOVED 2026-08-30, per the client: "a typical Google map, which
			comes default with a button to open on their phone for directions."

			This reverses a decision BUILD_PLAN argues for explicitly. The facade held a
			styled static map and only swapped in Google's iframe on click, because
			Google sets third-party cookies and pulls a large payload the instant it
			loads. That now happens for every visitor who opens Contact, whether or not
			they wanted a map. Recorded here so it reads as a choice, not as drift.

			What went with it: the Thunderforest/OSM static map and its required
			attribution (no longer using their tiles) and the "open it in Google Maps"
			escape link, whose job Get directions now does. The click-to-load script
			went too; the small script at the foot of this file is a different thing —
			it smooth-scrolls to the map and loads nothing.

			⚠️ `MAP_EMBED_URL` is still the undocumented `output=embed` stopgap. It was
			tolerable behind a click; it is now on every page load. See the note in
			`nav.ts` for the Share → Embed URL that should replace it.
		*/}
		<div class="map" id="map-region" tabindex="-1">
			<iframe
				class="map__frame"
				src={MAP_EMBED_URL}
				title="Google Maps showing Portage Place, 908 Portage Avenue, South Bend, Indiana"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
		</div>

	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* Plaster, per the client 2026-08-25. Restore with `tone="limestone"`. */}
	<Section data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">Still deciding?</p>
				<h2 class="cta__title">Have a look at what's here</h2>
				{/*
					Was "Sizes, wings and what fits where — plus the hundred-year story
					behind the building." The first half described the Suites page, which
					came out on 2026-08-30, and the button beside it went with it.
				*/}
				<p class="cta__lede">
					The hundred-year story behind the building.
				</p>
			</div>
			<div class="cta__actions">
				<Button variant="quiet" size="lg" href="/history">The history</Button>
				<Button variant="quiet" size="lg" href="/tenants">Under one roof</Button>
			</div>
		</div>
	</Section>
</BaseLayout>
<style lang="scss">
	.intro {
		max-width: 44rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.intro__actions {
		margin-block-start: var(--pp-space-l);
	}

	// ---------------------------------------------------------------------------
	.details {
		display: grid;
		gap: var(--pp-space-xl);

		// Two, per the client 2026-08-30. Was `repeat(3, 1fr)`; with Email and Phone
		// added that had become four columns of one fact each.
		//
		// `auto` tracks rather than `1fr`, because `1fr` fills the row and leaves
		// `justify-content` nothing to distribute. Sizing each column to its content
		// is what gives space-around something to space around.
		@include from('md') {
			grid-template-columns: repeat(2, auto);
			justify-content: space-around;
			gap: var(--pp-space-2xl);
		}
	}

	.detail__label {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-s);
	}


	// Phone and email. Fraunces, per the client 2026-08-30 — same construction as
	// `.detail__body` above, which is what the address used to be set in.
	//
	// The size is pinned rather than taken from `--pp-text-h4`. That token is
	// `fluid(24, 29)`, so 29px only arrives at a 1440px viewport and anything
	// narrower inspects smaller — which is the "should be larger" here. `rem()`
	// keeps it in rem so it still respects the user's browser font-size setting.
	// If these should grow past 29px on wide screens, `--pp-text-h3` is the token
	// (29px → 36px across the same range).
	.detail__contact {
		font-family: var(--pp-font-display);
		// Doubled from 29px, per the client 2026-08-30 — but only from `md` up.
		//
		// 58px flat overflows the 375px minimum viewport: `mfkeen@gmail.com` is 16
		// characters, and Fraunces averages about half an em per character, so 16 ×
		// 29px ≈ 464px of text in roughly 343px of container. It cannot wrap either,
		// an email being one unbroken token. So the doubling applies where there is
		// room for it and the phone stays legible below that.
		font-size: rem(32);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-strong);
        
		@include from('md') {
            text-decoration: none;
			font-size: rem(32);
            font-weight: 600;
		}

		// Belt and braces: nothing here may push the page into horizontal scroll,
		// whatever a future address turns out to be.
		overflow-wrap: break-word;

		+ .detail__contact {
			margin-block-start: var(--pp-space-3xs);
		}
	}

	// "Mike Keen, Leasing Agent" — styled exactly as .detail__address below it,
	// minus that block's top margin, so it reads as a caption on the email rather
	// than a separate fact.
	.detail__agent {
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-s);
		line-height: var(--pp-leading-normal);
		color: var(--pp-ink);
	}

	// The address drops to the access list's size and sits below a gap, so the
	// column reads as "act on these, and here is where it is" rather than three
	// equal facts.
	.detail__address {
		margin-block-start: var(--pp-space-l);
		font-size: var(--pp-text-s);
		font-style: normal;
		line-height: var(--pp-leading-normal);
		color: var(--pp-ink);
	}

	// Underlined rather than colour-only, so the link is distinguishable without
	// relying on hue (SC 1.4.1), and `min-target` keeps the tap area at 44px.
	// `inherit` so the size and face come from whichever block wraps it.
	//
	// ⚠️ There is a global `:where(p,li,dd,blockquote,figcaption) a` rule in the
	// base layer that paints links `--pp-green-link` with a 35% green underline.
	// `:where()` is zero-specificity so `color: inherit` beats it — but it does NOT
	// set `text-decoration-color`, so without the override below the underline
	// stays green under ink-strong text. `currentColor` makes it track whatever
	// colour the link actually is, hover included.
	.detail__link {
		color: inherit;
		// text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		// text-decoration-thickness: 1px;
		// text-underline-offset: 0.18em;
        text-decoration: none;
		transition: color var(--pp-duration-fast) var(--pp-ease-out);

		@include min-target;
		@include focusable;

		@include hover-capable {
			&:hover {
				color: var(--pp-brick-dark);
			}
		}
	}




	.access {
		display: grid;
		gap: var(--pp-space-2xs);
		margin: 0;
		padding: 0;
	}

	// The list and the button swapped places 2026-08-30, so the gap moved with
	// them. Mirrors .detail__address in the left column, so both columns break to
	// their secondary content at the same point.
	.detail__action {
		margin-block-start: var(--pp-space-l);
	}

	.access__item {
		display: flex;
		align-items: center;
		gap: var(--pp-space-2xs);
		font-size: var(--pp-text-s);
		color: var(--pp-ink);

		:global(svg) {
			flex: none;
			width: 16px;
			height: 16px;
			color: var(--pp-green);
		}
	}

	// ---------------------------------------------------------------------------
	// Map
	// ---------------------------------------------------------------------------
	// `.block-head` is NOT global — Home, Suites and Tenants each carry their own
	// copy in their own scoped style block, so a page using the markup without the
	// rules gets a completely unstyled heading. That is what happened here: with no
	// `margin-block-end` the h2 sat directly on the map and the descender of the
	// "g" in Neighborhood crossed into the image.
	//
	// Matching the other three exactly rather than inventing a local variant. See
	// the note in BUILD_PLAN about consolidating these four copies.
	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.block-head__lede {
		margin-block-start: var(--pp-space-s);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	// The Phase 2 layout from Suites, one frame instead of two. Stacked below `lg`
	// so the photograph gets the full column width on a phone, where it needs it —
	// a hundred faces at half width would be unreadable.
	.locale {
		display: grid;
		gap: var(--pp-space-xl);
		align-items: center;
		margin-block-end: var(--pp-space-xl);

		@include from('lg') {
			grid-template-columns: 1fr 1fr;
			gap: var(--pp-space-2xl);
		}
	}

	.locale__text {
		max-width: 40rem;
	}

	// The photograph keeps its whole frame, so the two columns are DELIBERATELY
	// unequal in height — the image runs taller than the heading beside it.
	//
	// Matching them was built and reverted (2026-08-26). Matching means cropping,
	// and at ~22% there is no crop that survives: the gold "Near Northwest
	// Neighborhood" sign sits at 3–8% of the frame and the kneeling front row at
	// 85–95%, which is 92% of a frame with only 78% to give. Every anchor loses one
	// or the other. Keeping the full frame keeps both, and `align-items: center`
	// makes the mismatch read as a composition rather than an accident.
	.locale__media {
		margin: 0;

		:global(img) {
			display: block;
			width: 100%;
			height: auto;
			border-radius: var(--pp-radius-m);
		}
	}

	// 16/9 on mobile, wider on desktop so the embed never becomes a tall slab in a
	// 1120px container. These used to be the exact ratios of the two static PNGs
	// (1006/674 and 2300/1354); with the artwork gone the box only has to be a
	// sensible shape for Google's tiles, which crop to whatever they are given.
	.map {
		width: 100%;
		// +30% height, per the client 2026-08-30: the divisor is 9 × 1.3 = 11.7 in
		// both crops. Google's embed has no dimension constraints — the iframe is
		// theirs to fill and the tiles simply re-centre — so this is ours to set.
		aspect-ratio: 16 / 11.7;
		overflow: hidden;
		// scrollIntoView honours scroll-margin, which is what keeps the map clear of
		// the sticky header. `:target` in _reset.scss covers the no-JS path; this
		// covers the smooth path, where preventDefault means :target never fires.
		scroll-margin-block-start: var(--pp-scroll-offset, 6rem);
		border-radius: var(--pp-radius-m);
		background-color: var(--pp-limestone);

		@include from('md') {
			aspect-ratio: 21 / 11.7;
		}

		// tabindex="-1" makes it a focus target for the Get directions anchor; the
		// ring would otherwise be noise on a non-interactive region.
		&:focus {
			outline: none;
		}
	}




	:global(.map__frame) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}




	// ---------------------------------------------------------------------------
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	// brick-dark, not bronze: bronze is 3.48:1 on plaster and 2.65:1 on limestone,
	// both failures for text. Bronze stays non-text only — rules, rings, markers.
	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>

<script>
	// Smooth scroll to the map, applied per-interaction.
	//
	// `_reset.scss` deliberately does NOT set `scroll-behavior: smooth` on <html>:
	// that would hijack every in-page jump on the site, skip links included, which
	// is disorienting for keyboard users. It says to apply it per interaction
	// instead, and this is that — one button, nothing else on the page affected.
	//
	// Reduced motion takes the early return rather than a shortened animation. A
	// long smooth scroll is precisely the vestibular trigger the media query exists
	// for, so the native jump is the correct behaviour there, not a faster glide.
	// The native jump still lands correctly because `:target` in the reset carries
	// the same scroll offset the smooth path gets from `scroll-margin`.
	const trigger = document.querySelector<HTMLAnchorElement>('[data-scroll-to-map]');
	const region = document.querySelector<HTMLElement>('#map-region');

	if (trigger && region) {
		trigger.addEventListener('click', (event) => {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			event.preventDefault();
			region.scrollIntoView({ behavior: 'smooth', block: 'start' });

			// `preventScroll` matters: focus() would otherwise snap the page to the
			// element instantly and cancel the animation that just started. The map is
			// a non-interactive region, so without this the button keeps focus and a
			// screen-reader user is left behind at the top of the page.
			region.focus({ preventScroll: true });
		});
	}
</script>
