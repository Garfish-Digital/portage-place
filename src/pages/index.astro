---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/Button.astro';
import StatStrip from '../components/StatStrip.astro';
import UseTypeGrid from '../components/UseTypeGrid.astro';
// Unused since the Then/Now pair was replaced by FloorPlan + Phase2 on
// 2026-08-30. Kept commented rather than deleted: the client may reverse.
// import BeforeAfter from '../components/BeforeAfter.astro';
import FloorPlan from '../components/FloorPlan.astro';
import Phase2 from '../components/Phase2.astro';

import { PROXIMITY, ACCESS } from '../config/site';
import { getMilestones } from '../lib/content';

// ⚠️ PLACEHOLDER IMAGERY — Rob's phone shots, hand-treated. Professional
// photography and video replace these in Phase 8. The hero is currently a still;
// the brief calls for a short silent loop with a poster frame once footage lands.
import heroImage from '../assets/heroes/home.jpg';
import heroImageMobile from '../assets/heroes/home-mobile.jpg';
// Restore together with <BeforeAfter> above.
// import then2 from '../assets/before-after/then-2.png';
// import now2 from '../assets/before-after/now-2.png';

const milestones = await getMilestones();
// const milestoneCount = milestones.length;
---

<BaseLayout
	title="Portage Place"
	description="Commercial and office space for lease in a restored 1919 bakery in South Bend's Near Northwest Neighborhood. Spaces from 200 to 1,800 sq ft, starting at $300 a month."
>
	{/* ================================================================== */}
	{/* Hero */}
	{/* ================================================================== */}
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		veil={54}
		alt="The restored Ward Baking Co. building on Portage Avenue, its two stories of windows reopened behind red brick and pale stone trim."
		eyebrow="South Bend · Near Northwest"
		title="Your place to be"
		lede="A collaborative village with a place for you."
		size="display"
		position="center 42%"
		priority
	>
		<Fragment slot="actions">
			<Button size="lg" iconEnd="lucide:arrow-right" href="/contact">Contact us</Button>
			<Button variant="quiet" size="lg" href="/tenants" data-surface="light">Under one roof</Button>
		</Fragment>
	</PageHero>

	{/* ================================================================== */}
	{/* Stat strip — immediately under the hero, where the qualifying */}
	{/* questions actually get asked. */}
	{/* ================================================================== */}
	<Section tight>
		<StatStrip />
	</Section>

	{/* ================================================================== */}
	{/* Use types — replaces the wall of text */}
	{/* ================================================================== */}
	{/*
		Plaster, matching the sections above and below — the limestone alternation
		is off here while the client looks at the page as one tone. Restore by
		putting `tone="limestone"` back.
	*/}
	<Section>
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">All under one roof</p>
			<h2>Room to think, work, and create</h2>
			<p class="block-head__lede">
				Retailers next to makers next to therapists next to software. The perfect mix.
			</p>
		</div>

		<UseTypeGrid />
	</Section>

	{/* ================================================================== */}
	{/* Floor plan + Phase 2 — moved here from Suites, per the client 2026-08-30 */}
	{/* ================================================================== */}
	{/*
		This replaced the Then/Now BeforeAfter pair, which the comment here used to
		call "the emotional hook" — the bricked-shut windows were the homepage's
		strongest story. The client asked for the plan and Phase 2 in its place.

		To reverse: restore the block from git and move these two lines back into
		`_spaces.astro`. Both components carry their own scoped styles and image
		imports, so nothing else has to move with them.
	*/}
	<FloorPlan />
	<Phase2 />

	{/* ================================================================== */}
	{/* Location */}
	{/* ================================================================== */}
	<Section tone="dark">
		<div class="split split--reverse">
			<div class="split__text">
				<p class="pp-eyebrow location__eyebrow">Getting here</p>
				<h2 class="location__title">Just minutes from downtown</h2>
				<p class="split__body">
					Portage Place anchors Portage Midtown, in the center of the Near Northwest Neighborhood.
				</p>

				<ul class="access" role="list">
					{
						ACCESS.map((item) => (
							<li class="access__item">
								<Icon name="lucide:check" aria-hidden="true" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="split__media">
				{/* A styled static map slots in beneath this list at Phase 4. */}
				<ul class="proximity" role="list">
					{
						PROXIMITY.map((place) => (
							<li class="proximity__item">
								<span class="proximity__name">
									{place.name}
									{'landmark' in place && place.landmark && (
										<span class="proximity__landmark"> · {place.landmark}</span>
									)}
								</span>
								<span class="proximity__rule" aria-hidden="true" />
								{/*
									The unit is spelled out for assistive tech but abbreviated
									visually, so a screen reader says "three minutes" rather
									than "three min".
								*/}
								<span class="proximity__time">
									{place.minutes}
									<span aria-hidden="true"> min</span>
									<span class="pp-visually-hidden"> minutes</span>
								</span>
								<span class="proximity__category">{place.category}</span>
							</li>
						))
					}
				</ul>
				<p class="proximity__note">Approximate drive times.</p>
			</div>
		</div>
	</Section>

	{/* ================================================================== */}
	{/* Closing CTA */}
	{/* ================================================================== */}
	{/* Plaster, per the client 2026-08-25. Restore with `tone="limestone"`. */}
	<Section data-cta-section>
		<div class="close">
			<h2 class="close__title">Come see what works</h2>
			<p class="close__lede">
				Tell us roughly what you're looking for — one simple email.
			</p>
			<Button size="lg" iconEnd="lucide:arrow-right" href="/contact">Contact us</Button>
		</div>
	</Section>
</BaseLayout>

<style lang="scss">
	// ---------------------------------------------------------------------------
	// Shared block heading
	// ---------------------------------------------------------------------------
	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.block-head__lede {
		margin-block-start: var(--pp-space-s);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	// ---------------------------------------------------------------------------
	// Split rows
	// ---------------------------------------------------------------------------
	.split {
		display: grid;
		gap: var(--pp-space-xl);
		align-items: center;

		@include from('lg') {
			grid-template-columns: 1fr 1fr;
			gap: var(--pp-space-3xl);
		}
	}

	.split--reverse .split__media {
		@include from('lg') {
			order: -1;
		}
	}

	.split__body {
		margin-block: var(--pp-space-s) var(--pp-space-l);
		max-width: 46ch;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	// ---------------------------------------------------------------------------
	// Location
	// ---------------------------------------------------------------------------
	// On espresso bronze reaches only 3.51:1, which fails for text. The inverse
	// muted ink is the dark-surface equivalent at 5.00:1.
	.location__eyebrow {
		color: var(--pp-ink-inverse-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.location__title {
		color: var(--pp-text-strong);
	}

	.access {
		display: grid;
		gap: var(--pp-space-2xs);
		margin: 0;
		padding: 0;
	}

	.access__item {
		display: flex;
		align-items: center;
		gap: var(--pp-space-2xs);
		font-size: var(--pp-text-s);
		color: var(--pp-text-muted);

		:global(svg) {
			flex: none;
			width: 16px;
			height: 16px;
			color: var(--pp-green-on-dark);
		}
	}

	.proximity {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
	}

	// Name and time share a baseline with a leader rule between them; the
	// category sits on a second row under the name. Naming the grid lines keeps
	// that readable rather than a wall of numeric spans.
	.proximity__item {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas:
			'name rule time'
			'cat  cat  cat';
		align-items: baseline;
		gap: var(--pp-space-3xs) var(--pp-space-2xs);
		padding-block-end: var(--pp-space-xs);
		border-block-end: 1px solid var(--pp-rule);
	}

	.proximity__item:last-child {
		border-block-end: 0;
		padding-block-end: 0;
	}

	.proximity__name {
		grid-area: name;
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-text-strong);
		text-wrap: balance;
	}

	// The landmark is a locator, not a second name — it stays subordinate so the
	// institution reads first.
	.proximity__landmark {
		font-family: var(--pp-font-body);
		font-size: var(--pp-text-s);
		font-weight: var(--pp-weight-normal);
		color: var(--pp-text-muted);
		white-space: nowrap;
	}

	// A leader rule, like a table of contents. Costs nothing and makes a plain
	// list read as designed. Hidden below `sm`, where there is rarely enough
	// horizontal room for it to read as anything but a stray dash.
	.proximity__rule {
		grid-area: rule;
		height: 1px;
		background-color: var(--pp-rule);
		translate: 0 -0.3em;

		@include until('sm') {
			display: none;
		}
	}

	.proximity__time {
		grid-area: time;
		font-family: var(--pp-font-body);
		font-size: var(--pp-text-s);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-text-strong);
		white-space: nowrap;
	}

	.proximity__category {
		grid-area: cat;
		@include eyebrow;

		font-size: var(--pp-text-2xs);
		color: var(--pp-text-muted);
	}

	.proximity__note {
		margin-block-start: var(--pp-space-s);
		font-size: var(--pp-text-xs);
		color: var(--pp-text-muted);
	}

	// ---------------------------------------------------------------------------
	// Close
	// ---------------------------------------------------------------------------
	.close {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: var(--pp-space-s);
		max-width: 40rem;
		margin-inline: auto;
	}

	.close__lede {
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}
</style>
