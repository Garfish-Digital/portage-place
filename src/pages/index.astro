---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import Stack from '../components/primitives/Stack.astro';
import Button from '../components/Button.astro';

// Phase 1 shell. Real copy, hero video, use-type grid, stat strip and location
// module arrive in Phase 3 — this exists so the foundations (layout, header,
// footer, CTA, surface contexts) are visible and testable at :4321.
---

<BaseLayout
	title="Portage Place"
	description="Commercial and office space for lease in a restored 1920s art-deco landmark in South Bend's Near Northwest Neighborhood. Spaces from 200 to 2,000 sq ft."
>
	<Section>
		<Stack space="m">
			<p class="pp-eyebrow eyebrow">South Bend, Indiana</p>
			<h1>Where you want to be.</h1>
			<p class="lede">
				A 1920s bakery, rescued and rebuilt. Coffee, yarn, art, medicine, software — twenty
				businesses under one roof, with room for yours.
			</p>
			<div class="actions">
				<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Email us</Button>
				<Button variant="quiet" size="lg" href="/spaces">Find your space</Button>
			</div>
		</Stack>
	</Section>

	<Section tone="limestone">
		<Stack space="s">
			<h2>Phase 1 foundations</h2>
			<p class="pp-measure">
				This page is scaffolding for the token layer, type scale, and layout primitives. The
				component specimen lives at <a href="/specimen">/specimen</a>.
			</p>
		</Stack>
	</Section>
</BaseLayout>

<style lang="scss">
	.eyebrow {
		color: var(--pp-ink-muted);
	}

	.lede {
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		max-width: 40ch;
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
		margin-block-start: var(--pp-space-s);
	}
</style>
