---
// Temporary deploy smoke-test page. Replaced once the real build begins.
// Netlify injects these at build time; they are undefined during local `astro dev`.
const buildTime = new Date().toISOString();
const context = process.env.CONTEXT ?? "local";
const branch = process.env.BRANCH ?? "—";
const commit = process.env.COMMIT_REF?.slice(0, 7) ?? "—";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>Portage Place — deploy check</title>
	</head>
	<body>
		<main>
			<h1>Portage Place</h1>
			<p class="lede">Pipeline is live. GitHub → Netlify → this page.</p>

			<dl>
				<dt>Build context</dt>
				<dd>{context}</dd>
				<dt>Branch</dt>
				<dd>{branch}</dd>
				<dt>Commit</dt>
				<dd>{commit}</dd>
				<dt>Built at</dt>
				<dd>{buildTime}</dd>
			</dl>

			<p class="note">
				This page is scaffolding. It gets deleted before launch.
			</p>
		</main>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
	}

	body {
		margin: 0;
		min-height: 100dvh;
		display: grid;
		place-items: center;
		font-family: system-ui, sans-serif;
		line-height: 1.5;
	}

	main {
		padding: 2rem;
		max-width: 34rem;
	}

	h1 {
		margin: 0 0 0.25rem;
		font-size: clamp(2rem, 6vw, 3rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0 0 2rem;
		opacity: 0.75;
	}

	dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.4rem 1.25rem;
		margin: 0 0 2rem;
		font-size: 0.9rem;
	}

	dt {
		opacity: 0.6;
	}

	dd {
		margin: 0;
		font-family: ui-monospace, monospace;
		overflow-wrap: anywhere;
	}

	.note {
		margin: 0;
		font-size: 0.8rem;
		opacity: 0.5;
	}
</style>
