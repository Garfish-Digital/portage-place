---
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import TenantCard from '../components/TenantCard.astro';
import PersonCard from '../components/PersonCard.astro';
import { getTenants, getOwners, getMentors, getNeighborhood } from '../lib/content';

// Order is locked in BUILD_PLAN: tenants → owners → neighbourhood → partners.
// Tenants lead because "look at this ecosystem, and here are the people who built
// it" earns the owners more credit than a bio page in isolation would.
const commercial = await getTenants({ category: 'commercial' });
const office = await getTenants({ category: 'office' });
const owners = await getOwners();
const mentors = await getMentors();
const neighbours = await getNeighborhood('neighbor');
const partners = await getNeighborhood('partner');

// NOT derived from how many cards we happen to show. The building has 20 tenants
// (9 commercial + 11 office); we surface a selection. Deriving the headline from
// the array length would silently tell visitors the building is half empty.
const TENANT_TOTAL = 20;
const shown = commercial.length + office.length;

// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/community.jpg';
---

<BaseLayout
	title="Community"
	description="The businesses, owners, neighbours and partners behind Portage Place — a restored 1919 bakery in South Bend's Near Northwest Neighborhood."
>
	<PageHero
		image={heroImage}
		alt="The shared kitchenette and dining area, with a long counter, exposed brick and a row of glazed offices behind."
		eyebrow="Who's here"
		title="A building as unique as the people in it."
		lede="Shops, wellness, & offices — a mix the neighborhood itself wanted."
		position="center 50%"
		priority
	/>

	{/* ------------------------------------------------------------------ */}
	{/* 1 — Tenants */}
	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" id="tenants">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Tenants</p>
			<h2>Twenty businesses, one roof.</h2>
			<p class="block-head__lede">
				Commercial spaces front Portage Avenue alongside private offices.
			</p>
		</div>

		<h3 class="group-label">Commercial</h3>
		<ul class="cards" role="list">
			{
				commercial.map((tenant) => (
					<li>
						<TenantCard tenant={tenant} />
					</li>
				))
			}
		</ul>

		<h3 class="group-label group-label--spaced">Office</h3>
		<ul class="cards" role="list">
			{
				office.map((tenant) => (
					<li>
						<TenantCard tenant={tenant} />
					</li>
				))
			}
		</ul>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* 2 — Neighbourhood */}
	{/* ------------------------------------------------------------------ */}
	<Section id="neighborhood">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Neighbourhood</p>
			<h2>The corridor, not just the building.</h2>
			<p class="block-head__lede">
				Portage Place anchors Portage Midtown. These are the neighbours who make the
				block worth walking.
			</p>
		</div>

		<ul class="links" role="list">
			{
				neighbours.map((item) => (
					<li class:list={['link-card', item.data.placeholder && 'link-card--placeholder']}>
						<h3 class="link-card__name">
							{item.data.url ? (
								<a href={item.data.url} target="_blank" rel="noopener noreferrer">
									{item.data.name}
									<Icon name="lucide:arrow-up-right" aria-hidden="true" />
									<span class="pp-visually-hidden">(opens in a new tab)</span>
								</a>
							) : (
								item.data.name
							)}
						</h3>
						<p class="link-card__blurb">{item.data.blurb}</p>
						{item.data.address && <p class="link-card__address">{item.data.address}</p>}
						{item.data.placeholder && <p class="link-card__flag">Placeholder entry</p>}
					</li>
				))
			}
		</ul>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* 3 — Owners */}
	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" id="owners">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Owners</p>
			<h2>Four people pulled a neglected bakery out of tax arrears.</h2>
			<p class="block-head__lede">
				Six attempts to rescue this building had failed, then they took it on.
			</p>
		</div>

		<ul class="cards cards--people" role="list">
			{
				owners.map((person) => (
					<li>
						<PersonCard person={person} />
					</li>
				))
			}
		</ul>

		{
			mentors.length > 0 && (
				<div class="mentors">
					<h3 class="group-label">The model</h3>
					<ul class="mentors__list" role="list">
						{mentors.map((person) => (
							<li class="mentor">
								<p class="mentor__name">{person.data.name}</p>
								<p class="mentor__role">{person.data.role}</p>
								{person.data.titles.map((title) => (
									<p class="mentor__title">{title}</p>
								))}
								{person.data.links.map((link) => (
									<a
										class="mentor__link"
										href={link.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{link.label}
										<Icon name="lucide:arrow-up-right" aria-hidden="true" />
										<span class="pp-visually-hidden">(opens in a new tab)</span>
									</a>
								))}
							</li>
						))}
					</ul>
				</div>
			)
		}
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* 4 — Partners */}
	{/* ------------------------------------------------------------------ */}
	<Section id="partners">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Partners</p>
			<h2>It took a lot of group effort and patience.</h2>
			<p class="block-head__lede">
				Tax abatements, a façade grant, READI funds and two loans — the renovation
				would not have happened without them.
			</p>
		</div>

		{/*
			Names, not logos. Partner marks need written permission and vector source,
			and the City of South Bend asset we hold is the official municipal seal —
			which implies endorsement rather than partnership. See BUILD_PLAN.
		*/}
		<ul class="links" role="list">
			{
				partners.map((item) => (
					<li class="link-card">
						<h3 class="link-card__name">{item.data.name}</h3>
						<p class="link-card__blurb">{item.data.blurb}</p>
					</li>
				))
			}
		</ul>
	</Section>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">Room for one more</p>
				<h2 class="cta__title">Your business would fit here.</h2>
				<p class="cta__lede">
					Tell us what you're looking for. Send a simple email.
				</p>
			</div>
			<div class="cta__actions">
				<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Email us</Button>
				<Button variant="quiet" size="lg" href="/spaces">Find your space</Button>
			</div>
		</div>
	</Section>
</BaseLayout>

<style lang="scss">
	.intro {
		max-width: 46rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.block-head__lede {
		margin-block-start: var(--pp-space-s);
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.group-label {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-s);
	}

	.group-label--spaced {
		margin-block-start: var(--pp-space-xl);
	}

	// ---------------------------------------------------------------------------
	// Card grids
	// ---------------------------------------------------------------------------
	.cards {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		// `stretch` is the grid default, and it is what made an expanding card drag
		// every sibling in its row to the same height. Tenant cards want equal
		// heights, so they opt back in below; anything that grows must not.
		align-items: start;
	}

	// Tenant cards have no expanding content, so equal heights are safe and tidier.
	.cards:not(.cards--people) {
		align-items: stretch;
	}

	// One card per row: the owner cards span the container so the sketches can be
	// larger. This also removes the row-stretch that made a single open bio inflate
	// every other card in its row to match — they grew without opening, which read
	// as the disclosure firing on all of them.
	.cards--people {
		grid-template-columns: 1fr;
		gap: var(--pp-space-m);
	}

	// ---------------------------------------------------------------------------
	// Mentors — small, at the foot of the owners section
	// ---------------------------------------------------------------------------
	.mentors {
		margin-block-start: var(--pp-space-2xl);
		padding-block-start: var(--pp-space-l);
		border-block-start: 1px solid var(--pp-rule);
	}

	.mentors__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-xl);
		margin: 0;
		padding: 0;
	}

	.mentor__name {
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-base);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-ink-strong);
	}

	.mentor__role,
	.mentor__title {
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	.mentor__link {
		display: inline-flex;
		align-items: center;
		gap: 0.25em;
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-green-link);
		text-decoration: none;

		@include focusable;

		:global(svg) {
			width: 13px;
			height: 13px;
		}
	}

	// ---------------------------------------------------------------------------
	// Neighbourhood / partners
	// ---------------------------------------------------------------------------
	.links {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
	}

	.link-card {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-3xs);
		padding: var(--pp-space-m);
		background-color: var(--pp-raised);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);
	}

	.link-card--placeholder {
		border-style: dashed;
		border-color: var(--pp-brick-mid);
	}

	.link-card__name {
		font-size: var(--pp-text-base);
		line-height: var(--pp-leading-snug);

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.25em;
			color: inherit;
			text-decoration: none;

			@include focusable;

			:global(svg) {
				width: 0.65em;
				height: 0.65em;
				color: var(--pp-brick-mid);
			}

			@include hover-capable {
				&:hover {
					color: var(--pp-green-link);
				}
			}
		}
	}

	.link-card__blurb {
		font-size: var(--pp-text-s);
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.link-card__address {
		font-size: var(--pp-text-xs);
		color: var(--pp-text-muted);
	}

	.link-card__flag {
		@include eyebrow;

		margin-block-start: auto;
		padding-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-2xs);
		color: var(--pp-brick-dark);
	}

	// ---------------------------------------------------------------------------
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	// brick-dark, not bronze: bronze is 3.48:1 on plaster and 2.65:1 on limestone,
	// both failures for text. Bronze stays non-text only — rules, rings, markers.
	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>
