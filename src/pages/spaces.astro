---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import UseTypeGrid from '../components/UseTypeGrid.astro';
import { getSpaceRange, getSpaceTypes, getSpaceTypeSummary } from '../lib/content';
import { SPACE_TYPE_ICONS, SPACE_TYPE_ICON_FALLBACK } from '../config/site';

// ⚠️ 2021 PROPOSED PLAN — for rough-in only. Carries Kil Architecture's title
// block; must be cropped or redrawn before anything ships.
import planImage from '../assets/plans/first-floor-2021.webp';

// Phase 2 in progress, shot 2026. Evidence that "more coming" is actually
// happening — which is the only reason these earn space on a leasing page.
import phase2Skylight from '../assets/phase-2/skylight.jpg';
import phase2Openings from '../assets/phase-2/openings.jpg';

const range = await getSpaceRange();
const types = await getSpaceTypes();
const typeSummary = await getSpaceTypeSummary();

// Seven types come out of the floor plan; "Health" is the eighth and is NOT in
// spaces.yaml. It's a use rather than a unit type — Alchemy Healing Arts is a
// real tenant, so the building demonstrably houses one, but no unit on the 2021
// drawing is drawn as a treatment room. Appended deliberately, and appended last
// so it never displaces a type the data actually supports. Icon matches the
// "Health & wellness" entry on the Home grid.
const typeItems = [
	...types.map((entry) => ({
		icon: SPACE_TYPE_ICONS[entry.type] ?? SPACE_TYPE_ICON_FALLBACK,
		label: entry.type,
	})),
	{ icon: 'lucide:heart-pulse', label: 'Health' },
];

const fmt = (n: number) => n.toLocaleString('en-US');

// Collapses to a single figure where a type has one unit — "703–703" reads as a
// mistake rather than as precision.
const sqftRange = ({ min, max }: { min: number; max: number }) =>
	min === max ? fmt(min) : `${fmt(min)}–${fmt(max)}`;

// Prose gets rounded figures; the table gets exact ones. Quoting "211 to 1,789"
// in a sentence claims a precision a four-year-old *proposed* plan can't support,
// and reads as oddly specific besides.
const roundDown = (n: number, to: number) => Math.floor(n / to) * to;
const roundUp = (n: number, to: number) => Math.ceil(n / to) * to;
const approx = { min: roundDown(range.min, 50), max: roundUp(range.max, 100) };

// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/spaces.jpg';
import heroImageMobile from '../assets/heroes/spaces-mobile.jpg';
---

<BaseLayout
	title="Find Your Space"
	description="Commercial, studio and office space for lease at Portage Place — a restored 1919 bakery in South Bend. Units from roughly 200 to 1,800 usable square feet."
>
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		alt="A glazed private office inside the building, framed in black steel against exposed brick and painted ductwork, with polished concrete floors."
		eyebrow="Space available"
		title="Find the one that fits"
		lede={`Roughly ${fmt(approx.min)} to ${fmt(approx.max)} usable square feet, starting at $300 a month.`}
		position="center 50%"
		priority
	>
		<Fragment slot="actions">
			<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Ask about a space</Button>
		</Fragment>
	</PageHero>

	{/* ------------------------------------------------------------------ */}
	{/* What kinds of space */}
	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">What's here</p>
			{/* Counts the rendered cards, not the collection — the grid carries an
				appended entry that isn't in spaces.yaml, and a hard-coded "8" would
				drift the first time a unit type is added or dropped. */}
			<h2>{typeItems.length} kinds of suites under one roof</h2>
			<p class="block-head__lede">
				Our building offers what an office park
				doesn't.
			</p>
		</div>

		{/*
			Same component as the Home page's use-type grid, not a lookalike. This
			was a numeral-led list in its own layout, which read as a third kind of
			card for no reason. Counts moved to "Sizes at a glance" below, where a
			number is what the section is for.
		*/}
		<UseTypeGrid items={typeItems} />
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* The plan */}
	{/* ------------------------------------------------------------------ */}
	<Section>
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">The floor plan</p>
			<h2>Ground floor</h2>
		</div>

		{/*
			ROUGH-IN ONLY. This becomes an interactive SVG whose <path> ids match the
			`id` field on each unit in spaces.yaml — hover to highlight, click for
			detail, pinch-zoom on mobile, with the list below as the accessible
			equivalent rather than an afterthought.
		*/}
		<figure class="plan">
			<Image
				src={planImage}
				alt="Architect's proposed ground-floor plan showing numbered retail units along the Portage Avenue frontage, warehouse and flex bays to the rear, and a block of lettered studios in the center."
				widths={[720, 1080, 1200]}
				sizes="(min-width: 1024px) 70vw, 94vw"
				loading="lazy"
			/>
			<figcaption class="plan__caption">
				<Icon name="lucide:triangle-alert" aria-hidden="true" />
				<span>
					<strong>Placeholder.</strong> Kil Architecture's <em>proposed</em> first-floor
					plan, dated 22 September 2021 — not as-built, ground floor only, and it still
					carries the architect's title block. Replaced before launch by a current plan,
					redrawn as an interactive vector.
				</span>
			</figcaption>
		</figure>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* Unit list */}
	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Every unit</p>
			<h2>Sizes at a glance</h2>
			<p class="block-head__lede">
				<strong>Usable</strong> square feet is the space you occupy.&nbsp;
				<strong>Rentable</strong> adds a share of the common areas and is what a lease is
				normally written against. Both are listed so there are no surprises.
			</p>
		</div>

		{/*
			One row per TYPE, not per unit. This was two tables and 33 rows of a
			four-year-old proposed plan — the densest block on the site, and the
			content least able to survive scrutiny. Seven rows answers the question a
			prospect actually has ("is there something my size?") without quoting a
			figure anyone could hold us to.

			The two ranges stay in separate columns because they are separate
			measures: sqftMin is usable and sqftMax is rentable for the SAME unit, so
			a single "211–1,158" column would span two different things at once.
		*/}
		<div class="table-wrap">
			<table class="units">
				<thead>
					<tr>
						<th scope="col">Type</th>
						<th scope="col" class="units__num">Units</th>
						<th scope="col" class="units__num">Usable</th>
						<th scope="col" class="units__num">Rentable</th>
					</tr>
				</thead>
				<tbody>
					{
						typeSummary.map((entry) => (
							<tr>
								<th scope="row">
									<span class="units__type">
										<Icon
											name={SPACE_TYPE_ICONS[entry.type] ?? SPACE_TYPE_ICON_FALLBACK}
											class="units__icon"
											aria-hidden="true"
										/>
										{entry.type}
									</span>
								</th>
								<td class="units__num">{entry.count}</td>
								<td class="units__num">{sqftRange(entry.usable)}</td>
								<td class="units__num">{sqftRange(entry.rentable)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<p class="units__note">
			Square feet from the 2021 proposed plan and subject to confirmation. We don't
			publish live availability — email us and we'll tell you what's actually available
			today, unit by unit.
		</p>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* Phase 2 */}
	{/* ------------------------------------------------------------------ */}
	<Section>
		<div class="phase2">
			<div class="phase2__text">
				<p class="pp-eyebrow block-head__eyebrow">Coming</p>
				<h2>Phase 2 is under way</h2>
				<p class="block-head__lede">
					The ground floor is roughly 20,000 of the building's 56,000 square feet. The
					basement and second floor follow, built out much the same way — so if you
					need more room than exists today, it's worth asking.
				</p>
			</div>

			{/*
				Two photographs, not six. BUILD_PLAN keeps Phase 2 "mentioned, not
				featured" — enough that a tenant needing more room knows to ask, not
				enough to distract from what's available now. Captioned and dated so
				nobody mistakes a construction site for a space they can lease today.
			*/}
			<figure class="phase2__media">
				<div class="phase2__frames">
					<Image
						src={phase2Skylight}
						alt="Interior of the Phase 2 space: a skylight over exposed timber joists and pale brick walls, with stacked lumber and buckets on the concrete floor."
						widths={[420, 640, 900]}
						sizes="(min-width: 1024px) 24vw, (min-width: 768px) 44vw, 92vw"
						loading="lazy"
					/>
					<Image
						src={phase2Openings}
						alt="Two large openings cut through a brick pier, looking into an adjoining bay with steel columns and a timber ceiling."
						widths={[420, 640, 900]}
						sizes="(min-width: 1024px) 24vw, (min-width: 768px) 44vw, 92vw"
						loading="lazy"
					/>
				</div>
				<figcaption class="phase2__caption">Phase 2 in progress, 2026.</figcaption>
			</figure>
		</div>
	</Section>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">No commitment</p>
				<h2 class="cta__title">Tell us roughly what you need</h2>
				<p class="cta__lede">
					Square footage, or just the kind of business — an email is all it takes.
				</p>
			</div>
			<div class="cta__actions">
				<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Email us</Button>
				<Button variant="quiet" size="lg" href="/community">See who's here</Button>
			</div>
		</div>
	</Section>
</BaseLayout>

<style lang="scss">
	.intro {
		max-width: 46rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.intro__actions {
		margin-block-start: var(--pp-space-l);
	}

	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.block-head__lede {
		margin-block-start: var(--pp-space-s);
		color: var(--pp-text-muted);
		text-wrap: pretty;

		strong {
			color: var(--pp-ink-strong);
		}
	}

	.group-label {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-s);
	}

	.group-label--spaced {
		margin-block-start: var(--pp-space-xl);
	}

	// ---------------------------------------------------------------------------
	// Plan
	// ---------------------------------------------------------------------------
	.plan {
		margin: 0;
	}

	.plan :global(img) {
		width: 100%;
		height: auto;
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);
		background-color: #fff;
	}

	.plan__caption {
		display: flex;
		align-items: start;
		gap: var(--pp-space-2xs);
		margin-block-start: var(--pp-space-s);
		max-width: var(--pp-measure);
		font-size: var(--pp-text-xs);
		line-height: var(--pp-leading-normal);
		color: var(--pp-ink-muted);

		strong {
			color: var(--pp-error);
		}

		:global(svg) {
			flex: none;
			width: 15px;
			height: 15px;
			margin-block-start: 0.15em;
			color: var(--pp-error);
		}
	}

	// ---------------------------------------------------------------------------
	// Unit table
	// ---------------------------------------------------------------------------
	// Wrapped so the table scrolls inside its own box rather than pushing the
	// page into horizontal overflow on a narrow phone.
	.table-wrap {
		overflow-x: auto;
	}

	.units {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--pp-text-s);

		th,
		td {
			text-align: start;
			padding: var(--pp-space-xs) var(--pp-space-s);
			border-block-end: 1px solid var(--pp-rule);
			white-space: nowrap;
		}

		thead th {
			@include eyebrow;

			font-size: var(--pp-text-2xs);
			color: var(--pp-ink-muted);
		}

		tbody th {
			font-weight: var(--pp-weight-semibold);
			color: var(--pp-ink-strong);
		}

		tbody tr:last-child th,
		tbody tr:last-child td {
			border-block-end: 0;
		}
	}

	// Same bronze icon as the grid above, so a "Retail" row and the "Retail" card
	// read as the same thing rather than two separate lists that share a word.
	.units__type {
		display: inline-flex;
		align-items: center;
		gap: var(--pp-space-2xs);
	}

	.units__icon {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--pp-bronze); // decorative, non-text — 3.48:1 clears the UI threshold
	}

	// Tabular figures so the columns align on the digit, not the glyph width.
	.units__num {
		text-align: end !important;
		font-variant-numeric: tabular-nums;
	}

	.units__note {
		margin-block-start: var(--pp-space-l);
		max-width: var(--pp-measure);
		font-size: var(--pp-text-s);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	// ---------------------------------------------------------------------------
	.phase2 {
		display: grid;
		gap: var(--pp-space-xl);
		align-items: center;

		@include from('lg') {
			grid-template-columns: 1fr 1fr;
			gap: var(--pp-space-2xl);
		}
	}

	.phase2__text {
		max-width: 40rem;
	}

	.phase2__media {
		margin: 0;
	}

	.phase2__frames {
		display: grid;
		gap: var(--pp-space-xs);
		grid-template-columns: 1fr 1fr;

		:global(img) {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
			object-fit: cover;
			border-radius: var(--pp-radius-m);
			background-color: var(--pp-limestone);
		}
	}

	.phase2__caption {
		margin-block-start: var(--pp-space-xs);
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>
