---
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
// One component for both sections. Tenants and neighbours render identically
// now, and two lookalike components would drift the first time either is
// touched.
import MarkTile from '../components/MarkTile.astro';
import PersonCard from '../components/PersonCard.astro';
import { getTenants, getOwners, getMentors, getNeighborhood } from '../lib/content';

// Order is locked in BUILD_PLAN: tenants → owners → neighborhood → partners.
// Tenants lead because "look at this ecosystem, and here are the people who built
// it" earns the owners more credit than a bio page in isolation would.
// ONE list, sorted by `order`. It was two calls concatenated as
// `[...commercial, ...office]`, which forced every commercial tenant ahead of
// every office one no matter what `order` said — so two tenants in different
// wings could not be sequenced relative to each other at all.
//
// The wing split stopped being rendered when the two groups merged into a single
// grid, so `category` is data about the building now, not a display control.
// `order` is the field for sequence, and this lets it actually work.
const tenants = await getTenants();
const owners = await getOwners();
const mentors = await getMentors();
const neighbors = await getNeighborhood('neighbor');
const partners = await getNeighborhood('partner');

// NOT derived from how many cards we happen to show. The building has 20 tenants
// (9 commercial + 11 office); we surface a selection. Deriving the headline from
// the array length would silently tell visitors the building is half empty.
const TENANT_TOTAL = 20;
const shown = tenants.length;

// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/tenants.jpg';
import heroImageMobile from '../assets/heroes/tenants-mobile.jpg';
---

<BaseLayout
	title="Tenants"
	description="The businesses, owners, neighbors and partners behind Portage Place — a restored 1919 bakery in South Bend's Near Northwest Neighborhood."
>
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		veil={69}
		alt="The shared kitchenette and dining area, with a long counter, exposed brick and a row of glazed offices behind."
		eyebrow="Who's here"
		title="A building as unique as the people in it"
		lede="Shops, wellness, & offices — a mix the neighborhood itself wanted."
		position="center 50%"
		priority
	>
		{/*
			Was "Ask about a space" opening the contact modal; now a plain link to
			Contact, per the client 2026-08-30. Still `size="lg"` with the arrow, and
			it still inherits the primary variant's dark-context pairing from
			`.hero__veil.pp-on-dark`, so it renders light-green on espresso rather than
			the mid-green that would collapse to 2.13:1 there.

			History deliberately keeps no hero CTA: its closing ask ("There is room for
			you") only means anything after the timeline has been read.
		*/}
		<Fragment slot="actions">
			<Button size="lg" iconEnd="lucide:arrow-right" href="/contact">Contact us</Button>
		</Fragment>
	</PageHero>

	{/* ------------------------------------------------------------------ */}
	{/* 1 — Tenants */}
	{/* ------------------------------------------------------------------ */}
	{/* Plaster, per the client 2026-08-25. Restore with `tone="limestone"`. */}
	<Section id="tenants">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Tenants</p>
			<h2>Several businesses under one roof</h2>
			<p class="block-head__lede">
				Commercial suites front Portage Avenue alongside private offices.
			</p>
		</div>

		{/*
			Commercial and office are one list now. The wing split earned its keep
			when there were ten cards across two labelled groups; with four it
			produced a heading over three tiles and a heading over one.

			Sequence comes from each entry's `order` field — see the note above the
			fetch for why it is a single sorted call rather than two concatenated.
		*/}
		<ul class="tiles" role="list">
			{
				tenants.map((tenant) => (
					<li>
						<MarkTile
							name={tenant.data.name}
							meta={tenant.data.type}
							url={tenant.data.url}
							mark={tenant.data.logo}
							markAlt={tenant.data.imageAlt}
						/>
					</li>
				))
			}
		</ul>

		{/*
			Right-aligned, per the client 2026-08-31. It sits at the end of the tile
			row where "A Place for You" leaves off — that card is the invitation, this
			is the thing to do about it, and the two read as a pair on the right edge.

			Same construction as every other Contact us on the site (primary, `lg`,
			trailing arrow), so it stays one recognisable action rather than a
			differently-dressed variant of it.
		*/}
		<div class="tiles-action">
			<Button size="lg" iconEnd="lucide:arrow-right" href="/contact">Contact us</Button>
		</div>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* 2 — Neighborhood */}
	{/* ------------------------------------------------------------------ */}
	<Section id="neighborhood">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Neighborhood</p>
			<h2>The corridor, not just the building</h2>
			<p class="block-head__lede">
				Portage Place anchors Portage Midtown. These are the neighbors who make the
				block worth walking.
			</p>
		</div>

		{/*
			Same tile as the tenants above — that identity is the point. The address
			now lives inside the blurb rather than on its own line, so a neighbour
			reads as a sentence about a place rather than a directory entry.
		*/}
		<ul class="tiles" role="list">
			{
				neighbors.map((item) => (
					<li>
						<MarkTile
							name={item.data.name}
							meta={item.data.blurb}
							url={item.data.url}
							mark={item.data.logo}
							markAlt={item.data.logoAlt}
						/>
					</li>
				))
			}
		</ul>
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/* 3 — Owners */}
	{/* ------------------------------------------------------------------ */}
	<!-- <Section tone="limestone" id="owners">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Owners</p>
			<h2>Four people pulled a neglected bakery out of tax arrears</h2>
			<p class="block-head__lede">
				Six attempts to rescue this building had failed, then they took it on.
			</p>
		</div>

		<ul class="cards cards--people" role="list">
			{
				owners.map((person) => (
					<li>
						<PersonCard person={person} />
					</li>
				))
			}
		</ul>

		{
			mentors.length > 0 && (
				<div class="mentors">
					<h3 class="group-label">The model</h3>
					<ul class="mentors__list" role="list">
						{mentors.map((person) => (
							<li class="mentor">
								<p class="mentor__name">{person.data.name}</p>
								<p class="mentor__role">{person.data.role}</p>
								{person.data.titles.map((title) => (
									<p class="mentor__title">{title}</p>
								))}
								{person.data.links.map((link) => (
									<a
										class="mentor__link"
										href={link.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{link.label}
										<Icon name="lucide:arrow-up-right" aria-hidden="true" />
										<span class="pp-visually-hidden">(opens in a new tab)</span>
									</a>
								))}
							</li>
						))}
					</ul>
				</div>
			)
		}
	</Section> -->

	{/* ------------------------------------------------------------------ */}
	{/* 4 — Partners */}
	{/* ------------------------------------------------------------------ */}
	<!-- <Section id="partners">
		<div class="block-head">
			<p class="pp-eyebrow block-head__eyebrow">Partners</p>
			<h2>It took a lot of group effort and patience</h2>
			<p class="block-head__lede">
				Tax abatements, a façade grant, READI funds and two loans — the renovation
				would not have happened without them.
			</p>
		</div>

		{/*
			Names, not logos. Partner marks need written permission and vector source,
			and the City of South Bend asset we hold is the official municipal seal —
			which implies endorsement rather than partnership. See BUILD_PLAN.
		*/}
		<ul class="links" role="list">
			{
				partners.map((item) => (
					<li class="link-card">
						<h3 class="link-card__name">{item.data.name}</h3>
						<p class="link-card__blurb">{item.data.blurb}</p>
					</li>
				))
			}
		</ul>
	</Section> -->

	{/* ------------------------------------------------------------------ */}
	{/* Plaster, per the client 2026-08-25. Restore with `tone="limestone"`. */}
	<Section data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">Room for one more</p>
				<h2 class="cta__title">Your business would fit here</h2>
				<p class="cta__lede">
					Tell us what you're looking for. Send a simple email.
				</p>
			</div>
			<div class="cta__actions">
				<Button size="lg" iconEnd="lucide:arrow-right" href="/contact">Contact us</Button>
			</div>
		</div>
	</Section>
</BaseLayout>

<style lang="scss">
	.intro {
		max-width: 46rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	.block-head {
		max-width: 44rem;
		margin-block-end: var(--pp-space-xl);
	}

	.block-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.block-head__lede {
		margin-block-start: var(--pp-space-s);
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.group-label {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-s);
	}

	.group-label--spaced {
		margin-block-start: var(--pp-space-xl);
	}

	// ---------------------------------------------------------------------------
	// Card grids
	// ---------------------------------------------------------------------------
	// Both sections. `auto-fit` rather than `auto-fill` is the whole trick: it
	// COLLAPSES the empty tracks, so three neighbours spread across three columns
	// instead of sitting in three of four with a gap on the end.
	//
	// The 20rem floor resolves a 1120px container to THREE columns: 1120 fits
	// 3 x 320 + 2 gaps = 992, and a fourth track would need 1328. That lands six
	// tenants as 3 + 3 and three neighbours as a single row — the same rhythm in
	// both sections, which is the point.
	//
	// It was 16rem, which gave four columns. That was right when tenants numbered
	// four; at six it would have produced a row of four over an orphan pair.
	//
	// `stretch` (the default) is wanted here: tiles are equal height and the cue
	// pins to the bottom of each, so the cues line up across a row.
	.tiles {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
	}

	// `flex` rather than `text-align: end`, so the button is aligned as a box
	// rather than as inline text — an <a> laid out inline would put its 44px hit
	// area in a slightly different place than it appears. `text-align` is kept as
	// a fallback for the same reason belt goes with braces: if the flex context is
	// ever lost, the button still lands on the right rather than the left.
	//
	// `xl` (48px), not `l` (32px). The tile grid's own gap is `s` (16px), so 32px
	// was only two grid gaps — close enough to the row rhythm that the button read
	// as another item in the grid rather than an action below it. 48px is three,
	// which is the first step that separates.
	.tiles-action {
		display: flex;
		justify-content: flex-end;
		text-align: end;
		margin-block-start: var(--pp-space-xl);
	}

	.cards {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		// `stretch` is the grid default, and it is what made an expanding card drag
		// every sibling in its row to the same height. Tenant cards want equal
		// heights, so they opt back in below; anything that grows must not.
		align-items: start;
	}

	// Tenant cards have no expanding content, so equal heights are safe and tidier.
	.cards:not(.cards--people) {
		align-items: stretch;
	}

	// One card per row: the owner cards span the container so the sketches can be
	// larger. This also removes the row-stretch that made a single open bio inflate
	// every other card in its row to match — they grew without opening, which read
	// as the disclosure firing on all of them.
	.cards--people {
		grid-template-columns: 1fr;
		gap: var(--pp-space-m);
	}

	// ---------------------------------------------------------------------------
	// Mentors — small, at the foot of the owners section
	// ---------------------------------------------------------------------------
	.mentors {
		margin-block-start: var(--pp-space-2xl);
		padding-block-start: var(--pp-space-l);
		border-block-start: 1px solid var(--pp-rule);
	}

	.mentors__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-xl);
		margin: 0;
		padding: 0;
	}

	.mentor__name {
		font-family: var(--pp-font-display);
		font-size: var(--pp-text-base);
		font-weight: var(--pp-font-display-weight);
		color: var(--pp-ink-strong);
	}

	.mentor__role,
	.mentor__title {
		font-size: var(--pp-text-xs);
		color: var(--pp-ink-muted);
	}

	.mentor__link {
		display: inline-flex;
		align-items: center;
		gap: 0.25em;
		margin-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-xs);
		font-weight: var(--pp-weight-semibold);
		color: var(--pp-green-link);
		text-decoration: none;

		@include focusable;

		:global(svg) {
			width: 13px;
			height: 13px;
		}
	}

	// ---------------------------------------------------------------------------
	// Neighborhood / partners
	// ---------------------------------------------------------------------------
	.links {
		display: grid;
		gap: var(--pp-space-s);
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
	}

	.link-card {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-3xs);
		padding: var(--pp-space-m);
		background-color: var(--pp-raised);
		border: 1px solid var(--pp-rule);
		border-radius: var(--pp-radius-m);
	}

	.link-card--placeholder {
		border-style: dashed;
		border-color: var(--pp-brick-mid);
	}

	.link-card__name {
		font-size: var(--pp-text-base);
		line-height: var(--pp-leading-snug);

		a {
			display: inline-flex;
			align-items: center;
			gap: 0.25em;
			color: inherit;
			text-decoration: none;

			@include focusable;

			:global(svg) {
				width: 0.65em;
				height: 0.65em;
				color: var(--pp-brick-mid);
			}

			@include hover-capable {
				&:hover {
					color: var(--pp-green-link);
				}
			}
		}
	}

	.link-card__blurb {
		font-size: var(--pp-text-s);
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.link-card__address {
		font-size: var(--pp-text-xs);
		color: var(--pp-text-muted);
	}

	.link-card__flag {
		@include eyebrow;

		margin-block-start: auto;
		padding-block-start: var(--pp-space-2xs);
		font-size: var(--pp-text-2xs);
		color: var(--pp-brick-dark);
	}

	// ---------------------------------------------------------------------------
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	// brick-dark, not bronze: bronze is 3.48:1 on plaster and 2.65:1 on limestone,
	// both failures for text. Bronze stays non-text only — rules, rings, markers.
	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>
