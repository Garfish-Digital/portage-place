---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import PressList from '../components/PressList.astro';
import Button from '../components/Button.astro';
import { getMilestones, getPress } from '../lib/content';

const milestones = await getMilestones();
const press = await getPress();

// Derived rather than typed in, so the intro can't drift from the data.
const firstYear = milestones[0]?.data.year ?? '1919';

// ⚠️ TEMPORARY HERO — Rob's phone shots, replaced by the professional shoot.
import heroImage from '../assets/heroes/history.jpg';
import heroImageMobile from '../assets/heroes/history-mobile.jpg';
---

<BaseLayout
	title="History"
	description="A 1919 industrial bakery in South Bend that kept reinventing itself — from Busse and Ward through forty years as a sealed warehouse to Portage Place."
>
	{/* ------------------------------------------------------------------ */}
	<PageHero
		image={heroImage}
		mobileImage={heroImageMobile}
		veil={64}
		alt="The restored building seen along Portage Avenue: two stories of red brick with stepped stone parapets, tall windows and young street trees."
		eyebrow={`Since ${firstYear}`}
		title="A building that keeps reinventing itself"
		lede="It began as a neighborhood bread plant, then it spent forty years with its windows bricked shut. Now the lights are back on."
		position="center 55%"
		priority
	/>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone" tight>
		<div class="note">
			<h2 class="note__title">The record</h2>
			<p class="note__body">
				Published accounts of this building state that the 1919 plant was built by <strong>Fred W. Busse</strong> for his bread making plant. It was acquired by Ward Baking Company a few years later, in which they ran business for 50 years. It was then occupied by <strong>Ford Distributing</strong>, a local wholesaler of
				vending goods and tobacco, before going empty.
			</p>
			<!-- <h2 class="note__title">A note on the record</h2>
			<p class="note__body">
				Published accounts of this building disagree with each other — on when it was
				built, when Ward took over, and when its last tenant arrived. Where sources
				conflict, we say so rather than picking the tidier version. Two corrections are
				worth stating plainly: the 1919 plant was built by <strong>Fred W. Busse</strong>,
				not by Ward; and <strong>Ford Distributing</strong> was a local wholesaler of
				vending goods and tobacco — <strong>not Ford Motor Company</strong>.
			</p> -->
		</div>
	</Section>

	{/* ------------------------------------------------------------------ */}
	<Section>
		<h2 class="pp-visually-hidden">Timeline</h2>
		<Timeline milestones={milestones} />
	</Section>

	{/* ------------------------------------------------------------------ */}
	<Section tone="limestone">
		<div class="press-head">
			<p class="pp-eyebrow press-head__eyebrow">In the news</p>
			<h2>Others have told this story too</h2>
			<p class="press-head__lede">
				Coverage of the renovation from local and national outlets.
			</p>
		</div>
		<PressList items={press} />
	</Section>

	{/* ------------------------------------------------------------------ */}
	{/*
		Contextual CTA at the end of the narrative: the reader has just finished the
		building's whole story, which is the natural decision point on this page.
	*/}
	<Section data-cta-section>
		<div class="cta">
			<div>
				<p class="pp-eyebrow cta__eyebrow">The next chapter</p>
				<h2 class="cta__title">There is room for you</h2>
				<p class="cta__lede">
					Suites from 200 to 1,800 square feet, in a building that has been useful for a
					hundred years.
				</p>
			</div>
			<div class="cta__actions">
				<Button size="lg" iconEnd="lucide:arrow-right" data-open-contact>Email us</Button>
				<Button variant="quiet" size="lg" href="/spaces">Find your space</Button>
			</div>
		</div>
	</Section>
</BaseLayout>

<style lang="scss">
	.intro {
		max-width: 46rem;
	}

	.intro__eyebrow {
		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.intro__lede {
		margin-block-start: var(--pp-space-m);
		font-size: var(--pp-text-lede);
		line-height: var(--pp-leading-snug);
		color: var(--pp-ink-muted);
		text-wrap: pretty;
	}

	// ---------------------------------------------------------------------------
	.note {
		max-width: var(--pp-measure);
		border-inline-start: 2px solid var(--pp-bronze);
		padding-inline-start: var(--pp-space-m);
	}

	.note__title {
		@include eyebrow;

		color: var(--pp-ink-muted);
		margin-block-end: var(--pp-space-2xs);
	}

	.note__body {
		font-size: var(--pp-text-s);
		line-height: var(--pp-leading-loose);
		color: var(--pp-ink);
		text-wrap: pretty;
	}

	// ---------------------------------------------------------------------------
	.press-head {
		max-width: 40rem;
		margin-block-end: var(--pp-space-xl);
	}

	.press-head__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.press-head__lede {
		margin-block-start: var(--pp-space-2xs);
		color: var(--pp-ink-muted);
	}

	// ---------------------------------------------------------------------------
	.cta {
		display: flex;
		flex-direction: column;
		gap: var(--pp-space-l);

		@include from('lg') {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--pp-space-2xl);
		}
	}

	// brick-dark, not bronze: bronze is 3.48:1 on plaster and 2.65:1 on limestone,
	// both failures for text. Bronze stays non-text only — rules, rings, markers.
	.cta__eyebrow {
		color: var(--pp-brick-dark);
		margin-block-end: var(--pp-space-2xs);
	}

	.cta__title {
		font-size: var(--pp-text-h2);
		color: var(--pp-text-strong);
	}

	.cta__lede {
		margin-block-start: var(--pp-space-xs);
		max-width: 34rem;
		color: var(--pp-text-muted);
		text-wrap: pretty;
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--pp-space-s);
	}
</style>
